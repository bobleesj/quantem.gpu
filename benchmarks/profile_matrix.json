{
  "schema_version": 1,
  "protocol_version": "quantem-gpu-profile/v1",
  "parity_matrix": "tests/parity/backend_matrix.json",
  "tiers": {
    "pr-smoke": {
      "purpose": "Disprove API, packaging, source-contract, and small synthetic parity regressions quickly.",
      "timing_policy": "No PR timing is promoted as a hardware performance result."
    },
    "scheduled-profile": {
      "purpose": "Measure stable frozen configurations on specified physical device configurations and retain run-level distributions.",
      "cadence": "Weekly when the owning runner is available, and after a relevant kernel or IO change."
    },
    "release-signoff": {
      "purpose": "Run real full-source, minimum-memory, and application wall-clock gates before a performance claim or release.",
      "cadence": "Manual and coordinated; never inferred from a larger device or prepared cache."
    },
    "diagnostic": {
      "purpose": "Profile a hypothesis with counters or traces without changing the accepted dashboard baseline.",
      "cadence": "As needed; every run still has a manifest and terminal status."
    }
  },
  "platforms": {
    "cpu-reference": {
      "authority": "macbook-pro-m5-max-128gb",
      "runner": "portable-cpu",
      "minimum_memory_gate": null
    },
    "cuda": {
      "authority": "linux-dual-blackwell-96gb",
      "runner": "physical-cuda",
      "minimum_memory_gate": "6 GiB dedicated VRAM"
    },
    "mps": {
      "authority": "macbook-pro-m5-max-128gb",
      "runner": "physical-python-mps",
      "minimum_memory_gate": "8 GB unified RAM"
    },
    "swift-metal": {
      "authority": "macbook-pro-m5-max-128gb",
      "runner": "physical-native-swift-metal",
      "minimum_memory_gate": "8 GB unified RAM"
    },
    "webgpu": {
      "authority": "macbook-pro-m5-max-128gb",
      "runner": "physical-hardware-browser",
      "minimum_memory_gate": "8 GB total laptop RAM"
    }
  },
  "capabilities": {
    "io.decode-bin-provenance": {
      "required_metrics": [
        "open_metadata_ms",
        "read_decode_ms",
        "reduction_layout_ms",
        "first_usable_product_ms",
        "total_wall_ms",
        "peak_memory"
      ]
    },
    "detector.integer-products": {
      "required_metrics": [
        "mean_dp_ms",
        "bf_ms",
        "adf_ms",
        "df_ms",
        "output_hashes"
      ]
    },
    "screening.prepared-products": {
      "required_metrics": [
        "build_wall_ms",
        "reopen_wall_ms",
        "pass_count",
        "mask_identity",
        "output_hashes"
      ]
    },
    "dpc.com-rotation-idpc": {
      "required_metrics": [
        "com_row_column_ms",
        "rotation_ms",
        "idpc_ms",
        "float_error_metrics"
      ]
    },
    "display.transform-histogram-color-fft": {
      "required_metrics": [
        "first_execution_ms",
        "warm_p50_ms",
        "warm_p95_ms",
        "output_hashes"
      ]
    },
    "ssb.object-phase-loss": {
      "required_metrics": [
        "object_ms",
        "phase_ms",
        "loss_ms",
        "phase_error_metrics",
        "output_hashes"
      ]
    },
    "ssb.calibration-200-nelder-mead": {
      "required_metrics": [
        "tpe_200_ms",
        "nelder_mead_ms",
        "total_fit_ms",
        "fitted_parameters",
        "repeatability_hashes"
      ]
    }
  },
  "comparison_contract": {
    "comparison_key": [
      "protocol_version",
      "cell_id",
      "source_identity",
      "source_shape",
      "source_dtype",
      "scan_region",
      "detector_region",
      "scan_bin",
      "detector_bin",
      "mask_signature",
      "precision",
      "cache_state",
      "timing_boundary",
      "device_id",
      "runtime_version",
      "source_revision"
    ],
    "cross_key_comparison": "forbidden",
    "parity_failure": "block",
    "default_regression_mode": "report-only",
    "minimum_accepted_sessions_before_hard_threshold": 5,
    "required_statistics": [
      "repetitions",
      "warmups",
      "p50",
      "p95",
      "maximum",
      "run_level_records"
    ]
  },
  "required_run_fields": [
    "experiment_id",
    "status",
    "code_revision",
    "dirty_diff_sha256",
    "source_identity",
    "parameters",
    "backend",
    "device",
    "runtime_versions",
    "cache_state",
    "timing_boundary",
    "run_level_timings",
    "memory",
    "parity",
    "output_hashes",
    "timestamps"
  ],
