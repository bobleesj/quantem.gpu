+  /// Prototype switch for the persistent pipelined phase/loss schedule:
+  /// `QUANTEM_SSB_PIPELINED=<workers>,<ring>`; unset or `0` keeps the
+  /// retained two-pass schedule.
+  private static let pipelinedSchedule: (workers: Int, ring: Int)? = {
+    guard let raw = ProcessInfo.processInfo.environment["QUANTEM_SSB_PIPELINED"],
+      raw != "0"
+    else { return nil }
+    let parts = raw.split(separator: ",").compactMap { Int($0) }
+    let workers = parts.first ?? 100
+    let ring = parts.count > 1 ? parts[1] : 4
+    return (max(65, workers), max(2, min(ring, MetalSSBEngine.batchCapacity)))
+  }()
