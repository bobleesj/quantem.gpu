+  private struct SSBPipelineParams {
+    var chunkCount: UInt32
+    var ring: UInt32
+    var items: UInt32
+    var spinLimit: UInt32
+    var workers: UInt32
+  }
+
+  /// Prototype diagnostic: largest worker count whose whole dispatch of the
+  /// pipelined kernel is simultaneously resident (all workers observe all
+  /// arrivals). Deadlock freedom of the pipelined schedule needs more resident
+  /// workers than ROW items per batch.
+  public func pipelinedResidentWorkers(candidates: [Int]) throws -> [Int: Bool] {
+    guard let pipelineSyncBuffer else { throw MetalSSBError.notPrepared }
+    var results: [Int: Bool] = [:]
+    for workers in candidates {
+      guard let commands = queue.makeCommandBuffer() else { throw MetalSSBError.commandQueue }
+      let clear = commands.makeBlitCommandEncoder()!
+      clear.fill(buffer: pipelineSyncBuffer, range: 0..<pipelineSyncBuffer.length, value: 0)
+      clear.endEncoding()
+      var params = parameters(batch: 1, offset: 0, aberrations: MetalSSBAberrations(c10Nanometers: 0, c12Nanometers: 0, phi12Radians: 0))
+      var pipeline = SSBPipelineParams(chunkCount: 1, ring: 2, items: 0, spinLimit: 1 << 20, workers: UInt32(workers))
+      let encoder = commands.makeComputeCommandEncoder()!
+      encoder.setComputePipelineState(pipelinedLossPipeline)
+      for index in [0, 1, 2, 3, 4, 5, 7, 8, 9, 10] { encoder.setBuffer(fftA, offset: 0, index: index) }
+      encoder.setBytes(&params, length: MemoryLayout<SSBParams>.stride, index: 6)
+      encoder.setBuffer(pipelineSyncBuffer, offset: 0, index: 11)
+      encoder.setBytes(&pipeline, length: MemoryLayout<SSBPipelineParams>.stride, index: 12)
+      encoder.dispatchThreadgroups(MTLSize(width: workers, height: 1, depth: 1),
+        threadsPerThreadgroup: MTLSize(width: 256, height: 1, depth: 1))
+      encoder.endEncoding()
+      try commitAndWait(commands)
+      let flags = pipelineSyncBuffer.contents().bindMemory(to: UInt32.self, capacity: 128)
+      results[workers] = flags[64] == 0
+    }
+    return results
+  }
