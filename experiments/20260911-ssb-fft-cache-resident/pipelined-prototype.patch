+// Persistent pipelined phase/loss: the column pass for BF b and the row pass
+// for earlier BFs run inside one dispatch, so the blocked intermediate lives
+// in a small ring of `ring` planes that stays in the GPU cache instead of
+// making a device memory round trip per BF. Worker threadgroups claim items from one
+// counter in a fixed order per batch of up to eight BFs:
+//   [COL(bf0) x 65][COL(bf1) x 65][ROW x 64][COL(bf2) x 65] ... [COL(bf7) x 65]
+// A COL item transforms four half-plane columns of one BF with the exact
+// pass-1 code and writes ring slot bf % ring; a ROW item owns two four-row
+// blocks for every BF of the batch with the exact pass-2 code, keeps the
+// eight-BF register sums, and adds them to phase_sum in batch order. Every
+// value therefore sees the same arithmetic in the same order as the two-pass
+// schedule; only which threadgroup performs it differs.
+//
+// Dependencies use relaxed device atomics plus device-scope fences:
+//   col_done[bf]  >= 65   before any ROW item reads bf
+//   row_done[bf]  >= 64   before a COL item overwrites slot bf % ring
+//   flush_done[pair] >= k before batch k adds its sums for that row pair
+// Only one batch's 64 ROW items can wait on COL items claimed after them, so
+// any dispatch of at least 65 resident workers cannot deadlock. Every spin is
+// bounded; on timeout the group raises the error flag and the host repeats the
+// objective on the two-pass schedule.
+struct SSBPipelineParams {
+    uint chunk_count;
+    uint ring;
+    uint items;
+    uint spin_limit;
+    uint workers;
+};
+
+constant constexpr uint ssb_pipeline_col_items = 65u;
+constant constexpr uint ssb_pipeline_row_items = 64u;
+constant constexpr uint ssb_pipeline_batch = 8u;
+constant constexpr uint ssb_pipeline_row_after = 2u;
+constant constexpr uint ssb_pipeline_full_items =
+    ssb_pipeline_col_items * ssb_pipeline_batch + ssb_pipeline_row_items;
+
+inline bool ssb_pipeline_wait(
+    device atomic_uint *counter, uint target, device atomic_uint *error_flag,
+    uint spin_limit, uint kind, uint item) {
+    uint seen = 0u;
+    uint noise = 0x9e3779b9u ^ item;
+    for (uint i = 0u; i < spin_limit; ++i) {
+        // Poll with a read-modify-write so the value comes from the coherence
+        // point; a relaxed load may be served from a stale per-core line.
+        seen = atomic_fetch_or_explicit(counter, 0u, memory_order_relaxed);
+        if (seen >= target) return true;
+        if ((i & 63u) == 63u &&
+            atomic_fetch_or_explicit(error_flag, 0u, memory_order_relaxed) != 0u) {
+            return false;
+        }
+        // Back off between polls so dozens of waiting groups do not saturate
+        // the atomic unit and starve the producers' ordinary memory traffic.
+        const uint delay = min(i + 1u, 64u) * 32u;
+        for (uint d = 0u; d < delay; ++d) {
+            noise ^= noise << 13u; noise ^= noise >> 17u; noise ^= noise << 5u;
+        }
+        if (noise == 0u) return false;  // unreachable; keeps the delay loop live
+    }
+    // Prototype diagnostic: first timeout records its wait kind, observed
+    // value, target and item in error_flag[1..4].
+    if (atomic_fetch_add_explicit(error_flag, 1u, memory_order_relaxed) == 0u) {
+        atomic_store_explicit(error_flag + 1u, kind, memory_order_relaxed);
+        atomic_store_explicit(error_flag + 2u, seen, memory_order_relaxed);
+        atomic_store_explicit(error_flag + 3u, target, memory_order_relaxed);
+        atomic_store_explicit(error_flag + 4u, item, memory_order_relaxed);
+    }
+    return false;
+}
+
+[[max_total_threads_per_threadgroup(256)]]
+kernel void ssb_pipelined_phase_moments(
+    device const float2 *half_g [[buffer(0)]],
+    device const float4 *bf_geometry [[buffer(1)]],
+    device const float *q_row [[buffer(2)]],
+    device const float *q_col [[buffer(3)]],
+    device const float2 *twiddle [[buffer(4)]],
+    device float2 *ring_planes [[buffer(5)]],
+    constant SSBParams &params [[buffer(6)]],
+    device const float2 *chi_trig [[buffer(7)]],
+    device const float2 *cross_trig [[buffer(8)]],
+    device float *phase_sum [[buffer(9)]],
+    device float *phase_sumsq [[buffer(10)]],
+    device atomic_uint *sync [[buffer(11)]],
+    constant SSBPipelineParams &pipeline [[buffer(12)]],
+    uint thread_index [[thread_index_in_threadgroup]],
+    uint threads_per_group [[threads_per_threadgroup]]) {
+    constexpr uint n = 512u;
+    constexpr uint half_cols = 257u;
+    constexpr uint block_rows = ssb_intermediate_block_rows;
+    constexpr uint block_float2 = half_cols * block_rows;
+    constexpr uint plane = n * half_cols;
+    constexpr float scale = 1.0f / 512.0f;
+    if (threads_per_group != 256u) return;
+
+    threadgroup float2 pool[4u * 512u + block_rows * ssb_row_tile_pitch];
+    threadgroup uint control[2];
+    threadgroup float2 *scratch = pool;
+    threadgroup float2 *tile = pool + 4u * 512u;
+
+    // Each counter class starts on its own 256-byte line.
+    device atomic_uint *claim = sync;
+    device atomic_uint *error_flag = sync + 64u;
+    device atomic_uint *col_done = sync + 128u;
+    device atomic_uint *row_done = col_done + pipeline.chunk_count;
+    device atomic_uint *flush_done = row_done + pipeline.chunk_count;
+
+    const uint g = thread_index >> 6u;
+    const uint tid = thread_index & 63u;
+    const uint src[8] = {
+        octal_reverse_512(tid * 8u + 0u), octal_reverse_512(tid * 8u + 1u),
+        octal_reverse_512(tid * 8u + 2u), octal_reverse_512(tid * 8u + 3u),
+        octal_reverse_512(tid * 8u + 4u), octal_reverse_512(tid * 8u + 5u),
+        octal_reverse_512(tid * 8u + 6u), octal_reverse_512(tid * 8u + 7u)
+    };
+    const float2 dc = float2(params.dc_r, params.dc_i);
+    const float2 dc_spatial = dc * (scale * scale);
+    const bool positive_dc = dc_spatial.x > 0.0f;
+    const float inverse_dc_real = positive_dc
+        ? 1.0f / dc_spatial.x : 0.0f;
+    const uint full_batches = pipeline.chunk_count / ssb_pipeline_batch;
+
+    if (pipeline.items == 0u) {
+        // Residency probe: every worker must observe all `workers` arrivals,
+        // which is only possible when the whole dispatch is resident at once.
+        if (thread_index == 0u) {
+            atomic_fetch_add_explicit(claim, 1u, memory_order_relaxed);
+            ssb_pipeline_wait(claim, pipeline.workers, error_flag, pipeline.spin_limit, 0u, 0u);
+        }
+        threadgroup_barrier(mem_flags::mem_device);
+        return;
+    }
+
+    while (true) {
+        if (thread_index == 0u) {
+            control[0] = atomic_fetch_add_explicit(claim, 1u, memory_order_relaxed);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        const uint item = control[0];
+        if (item >= pipeline.items) return;
+
+        // Decode the item. Full batches have a fixed stride; the final partial
+        // batch (fewer than eight BFs) follows the same order with its own size.
+        uint k = item / ssb_pipeline_full_items;
+        uint r = item - k * ssb_pipeline_full_items;
+        if (k > full_batches) { k = full_batches; r = item - full_batches * ssb_pipeline_full_items; }
+        const uint batch_size = min(ssb_pipeline_batch, pipeline.chunk_count - k * ssb_pipeline_batch);
+        const uint row_at = ssb_pipeline_col_items * min(batch_size, ssb_pipeline_row_after);
+        bool is_row = false;
+        uint j = 0u, cg = 0u, pair = 0u;
+        if (r < row_at) {
+            j = r / ssb_pipeline_col_items; cg = r - j * ssb_pipeline_col_items;
+        } else if (r < row_at + ssb_pipeline_row_items) {
+            is_row = true; pair = r - row_at;
+        } else {
+            const uint r2 = r - row_at - ssb_pipeline_row_items;
+            j = ssb_pipeline_row_after + r2 / ssb_pipeline_col_items;
+            cg = r2 - (j - ssb_pipeline_row_after) * ssb_pipeline_col_items;
+        }
+
+        if (!is_row) {
+            // ---- Column pass for local BF b, columns 4*cg .. 4*cg+3 ----
+            const uint local_bf = k * ssb_pipeline_batch + j;
+            if (thread_index == 0u) {
+                atomic_fetch_add_explicit(error_flag + 8u, 1u, memory_order_relaxed);
+                bool ok = true;
+                if (local_bf >= pipeline.ring) {
+                    ok = ssb_pipeline_wait(row_done + (local_bf - pipeline.ring),
+                        ssb_pipeline_row_items, error_flag, pipeline.spin_limit, 1u, item);
+                }
+                // One device-scope fence per group; the mem_device barrier
+                // orders the other threads' accesses after it.
+                atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+                control[1] = ok ? 1u : 0u;
+            }
+            threadgroup_barrier(mem_flags::mem_device);
+            if (control[1] == 0u) return;
+
+            const uint col_requested = cg * 4u + g;
+            const bool store = col_requested < half_cols;
+            const uint col = min(col_requested, half_cols - 1u);
+            const size_t half_base = (size_t)local_bf * plane;
+            const uint bf = params.bf_offset + local_bf;
+            threadgroup float2 *fft_scratch = scratch + g * 512u;
+            float2 r0, r1, r2, r3, r4, r5, r6, r7;
+#define LOAD_HERMITIAN_P(slot) \
+            if (src[slot] == 0u && col == 0u) { \
+                r##slot = float2(0.0f); \
+            } else { \
+                const float2 corrected = ssb_corrected_value_precomputed_chi( \
+                    half_g[half_base + (size_t)col * n + src[slot]], \
+                    src[slot], col, bf, bf_geometry, q_row, q_col, \
+                    chi_trig, cross_trig, params); \
+                r##slot = float2(corrected.y, -corrected.x); \
+            }
+            LOAD_HERMITIAN_P(0); LOAD_HERMITIAN_P(1);
+            LOAD_HERMITIAN_P(2); LOAD_HERMITIAN_P(3);
+            LOAD_HERMITIAN_P(4); LOAD_HERMITIAN_P(5);
+            LOAD_HERMITIAN_P(6); LOAD_HERMITIAN_P(7);
+#undef LOAD_HERMITIAN_P
+            ifft512_radix8_registers(
+                r0, r1, r2, r3, r4, r5, r6, r7, tid, twiddle, fft_scratch
+            );
+            if (store) {
+                const size_t slot_base = (size_t)(local_bf % pipeline.ring) * plane;
+                const size_t store_base = slot_base + (size_t)col * block_rows +
+                    (tid % block_rows);
+                constexpr size_t block_stride = (size_t)half_cols * block_rows;
+#define STORE_BLOCKED_P(slot) \
+                ring_planes[store_base + \
+                    (size_t)((tid + 64u * slot##u) / block_rows) * block_stride] = \
+                    r##slot * scale
+                STORE_BLOCKED_P(0); STORE_BLOCKED_P(1);
+                STORE_BLOCKED_P(2); STORE_BLOCKED_P(3);
+                STORE_BLOCKED_P(4); STORE_BLOCKED_P(5);
+                STORE_BLOCKED_P(6); STORE_BLOCKED_P(7);
+#undef STORE_BLOCKED_P
+            }
+            threadgroup_barrier(mem_flags::mem_device);
+            if (thread_index == 0u) {
+                atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+                atomic_fetch_add_explicit(col_done + local_bf, 1u, memory_order_relaxed);
+                atomic_fetch_add_explicit(error_flag + 9u, 1u, memory_order_relaxed);
+                atomic_fetch_add_explicit(error_flag + 10u + local_bf % 4u, 1u, memory_order_relaxed);
+            }
+            continue;
+        }
+
+        // ---- Row pass: row blocks 2*pair and 2*pair+1 for every BF of batch k ----
+        float sum[2][8];
+        float sumsq[2][8];
+        for (uint h = 0u; h < 2u; ++h) {
+            for (uint lane = 0u; lane < 8u; ++lane) { sum[h][lane] = 0.0f; sumsq[h][lane] = 0.0f; }
+        }
+        threadgroup float2 *fft_scratch = scratch + g * 512u;
+        const threadgroup float2 *tile_row = tile + g * ssb_row_tile_pitch;
+        bool ok = true;
+        for (uint jj = 0u; jj < batch_size && ok; ++jj) {
+            const uint local_bf = k * ssb_pipeline_batch + jj;
+            if (thread_index == 0u) {
+                control[1] = ssb_pipeline_wait(col_done + local_bf,
+                    ssb_pipeline_col_items, error_flag, pipeline.spin_limit, 2u, item) ? 1u : 0u;
+                atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+            }
+            threadgroup_barrier(mem_flags::mem_device);
+            if (control[1] == 0u) { ok = false; break; }
+
+            device const float2 *slot_plane =
+                ring_planes + (size_t)(local_bf % pipeline.ring) * plane;
+            float2 staged[2][ssb_row_block_loads];
+            ssb_fetch_row_block(slot_plane + (size_t)(2u * pair) * block_float2,
+                thread_index, staged[0]);
+            ssb_fetch_row_block(slot_plane + (size_t)(2u * pair + 1u) * block_float2,
+                thread_index, staged[1]);
+            for (uint h = 0u; h < 2u; ++h) {
+                // Previous tile reads finished before the FFT barrier.
+                for (uint jl = 0u; jl < ssb_row_block_loads; ++jl) {
+                    const uint e = thread_index + jl * 64u * block_rows;
+                    if (e < block_float2) {
+                        tile[(e % block_rows) * ssb_row_tile_pitch +
+                            ssb_row_tile_column(e / block_rows)] = staged[h][jl];
+                    }
+                }
+                threadgroup_barrier(mem_flags::mem_threadgroup);
+                if (h == 1u && thread_index == 0u) {
+                    // Both blocks of this BF have been consumed from the ring.
+                    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+                    atomic_fetch_add_explicit(row_done + local_bf, 1u, memory_order_relaxed);
+                }
+                float2 rr[8];
+                for (uint lane = 0u; lane < 8u; ++lane) {
+                    const uint col = src[lane];
+                    if (col < half_cols) {
+                        rr[lane] = tile_row[ssb_row_tile_column(col)];
+                    } else {
+                        const float2 mirrored = tile_row[ssb_row_tile_column(n - col)];
+                        rr[lane] = float2(mirrored.x, -mirrored.y);
+                    }
+                }
+                ifft512_radix8_registers(
+                    rr[0], rr[1], rr[2], rr[3], rr[4], rr[5], rr[6], rr[7],
+                    tid, twiddle, fft_scratch
+                );
+                for (uint lane = 0u; lane < 8u; ++lane) {
+                    const float hh = rr[lane].x * scale;
+                    const float imaginary = dc_spatial.y + hh;
+                    const float phase = positive_dc
+                        ? metal::atan(imaginary * inverse_dc_real)
+                        : metal::atan2(imaginary, dc_spatial.x);
+                    sum[h][lane] += phase;
+                    sumsq[h][lane] += phase * phase;
+                }
+            }
+        }
+        if (!ok) return;
+        // Add this batch's sums after the previous batch for the same rows.
+        if (thread_index == 0u) {
+            control[1] = ssb_pipeline_wait(flush_done + pair, k, error_flag,
+                pipeline.spin_limit, 3u, item) ? 1u : 0u;
+            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+        }
+        threadgroup_barrier(mem_flags::mem_device);
+        if (control[1] == 0u) return;
+        for (uint h = 0u; h < 2u; ++h) {
+            const uint row = (2u * pair + h) * block_rows + g;
+            for (uint lane = 0u; lane < 8u; ++lane) {
+                const uint col = tid + lane * 64u;
+                const uint pixel = row * n + col;
+                phase_sum[pixel] += sum[h][lane];
+                phase_sumsq[pixel] += sumsq[h][lane];
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_device);
+        if (thread_index == 0u) {
+            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+            atomic_fetch_add_explicit(flush_done + pair, 1u, memory_order_relaxed);
+        }
+    }
+}
