+  /// Persistent pipelined schedule over every cache chunk. Returns false if
+  /// any dispatch reported a bounded-spin timeout; the caller then clears the
+  /// moments and repeats the objective on the two-pass schedule.
+  private func runPipelinedCachedPhaseLoss(
+    aberrations: MetalSSBAberrations,
+    workers: Int,
+    ring: Int,
+    gpuSeconds: inout Double
+  ) throws -> Bool {
+    guard let chiTrigBuffer, let crossTrigBuffer, let pipelineSyncBuffer else {
+      throw MetalSSBError.allocation("exact phase-loss tables")
+    }
+    guard let commands = queue.makeCommandBuffer() else {
+      throw MetalSSBError.commandQueue
+    }
+    var globalOffset = 0
+    for (cache, cacheCount) in zip(cacheBuffers, cacheCounts) {
+      let clear = commands.makeBlitCommandEncoder()!
+      clear.fill(buffer: pipelineSyncBuffer, range: 0..<pipelineSyncBuffer.length, value: 0)
+      clear.endEncoding()
+      var params = parameters(batch: cacheCount, offset: globalOffset, aberrations: aberrations)
+      let fullBatches = cacheCount / Self.phaseBatchCapacity
+      let partial = cacheCount - fullBatches * Self.phaseBatchCapacity
+      let items = fullBatches * (65 * Self.phaseBatchCapacity + 64)
+        + (partial > 0 ? 65 * partial + 64 : 0)
+      var pipeline = SSBPipelineParams(
+        chunkCount: UInt32(cacheCount),
+        ring: UInt32(ring),
+        items: UInt32(items),
+        spinLimit: 1 << 20,
+        workers: UInt32(workers)
+      )
+      let encoder = commands.makeComputeCommandEncoder()!
+      encoder.setComputePipelineState(pipelinedLossPipeline)
+      encoder.setBuffer(cache, offset: 0, index: 0)
+      encoder.setBuffer(activeGeometryBuffer, offset: 0, index: 1)
+      encoder.setBuffer(qxBuffer, offset: 0, index: 2)
+      encoder.setBuffer(qyBuffer, offset: 0, index: 3)
+      encoder.setBuffer(twiddleBuffer, offset: 0, index: 4)
+      encoder.setBuffer(fftA, offset: 0, index: 5)
+      encoder.setBytes(&params, length: MemoryLayout<SSBParams>.stride, index: 6)
+      encoder.setBuffer(chiTrigBuffer, offset: 0, index: 7)
+      encoder.setBuffer(crossTrigBuffer, offset: 0, index: 8)
+      encoder.setBuffer(phaseSumBuffer, offset: 0, index: 9)
+      encoder.setBuffer(phaseSumSquaredBuffer, offset: 0, index: 10)
+      encoder.setBuffer(pipelineSyncBuffer, offset: 0, index: 11)
+      encoder.setBytes(&pipeline, length: MemoryLayout<SSBPipelineParams>.stride, index: 12)
+      encoder.dispatchThreadgroups(
+        MTLSize(width: workers, height: 1, depth: 1),
+        threadsPerThreadgroup: MTLSize(width: 256, height: 1, depth: 1)
+      )
+      encoder.endEncoding()
+      globalOffset += cacheCount
+    }
+    try commitAndWait(commands)
+    gpuSeconds += gpuDuration(commands)
+    let flags = pipelineSyncBuffer.contents().bindMemory(to: UInt32.self, capacity: 128)
+    if flags[64] != 0 {
+      FileHandle.standardError.write(Data("MetalSSBEngine: pipelined timeout kind=\(flags[65]) seen=\(flags[66]) target=\(flags[67]) item=\(flags[68]) timeouts=\(flags[64]) colStart=\(flags[72]) colEnd=\(flags[73]) perBF=\(flags[74]),\(flags[75]),\(flags[76]),\(flags[77]) claims=\(flags[0]) colDone0=\(flags[128])\n".utf8))
+      // Timed out: discard partial moments and let the caller rerun the
+      // retained schedule from cleared sums.
+      guard let reset = queue.makeCommandBuffer(), let blit = reset.makeBlitCommandEncoder() else {
+        throw MetalSSBError.commandQueue
+      }
+      blit.fill(buffer: phaseSumBuffer, range: 0..<phaseSumBuffer.length, value: 0)
+      blit.fill(buffer: phaseSumSquaredBuffer, range: 0..<phaseSumSquaredBuffer.length, value: 0)
+      blit.endEncoding()
+      try commitAndWait(reset)
+      FileHandle.standardError.write(Data("MetalSSBEngine: pipelined phase/loss timed out; repeating on the two-pass schedule\n".utf8))
+      return false
+    }
+    return true
+  }
