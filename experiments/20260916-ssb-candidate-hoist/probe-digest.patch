+// SCRATCH(hoist-probe): candidate-dependence digest. Reads a buffer region and
+// folds it into a single 64-bit value with an order-independent reduction, so
+// two runs of the same pipeline stage can be compared byte-for-byte without a
+// host round trip. Not part of any production path.
+kernel void ssb_probe_digest(
+    device const uint *words [[buffer(0)]],
+    device atomic_uint *out [[buffer(1)]],
+    constant uint &count [[buffer(2)]],
+    uint gid [[thread_position_in_grid]]) {
+    const uint start = gid * 16u;
+    if (start >= count) return;
+    const uint end = min(start + 16u, count);
+    ulong h = 1469598103934665603ul;
+    for (uint i = start; i < end; ++i) {
+        h ^= (ulong)words[i];
+        h *= 1099511628211ul;
+        h ^= (ulong)(i + 1u);
+    }
+    // 64-bit RMW is unavailable on this target, so fold the two halves into two
+    // independent 32-bit accumulators. Addition is commutative, so the result is
+    // deterministic regardless of thread scheduling.
+    atomic_fetch_add_explicit(out, (uint)h, memory_order_relaxed);
+    atomic_fetch_add_explicit(out + 1u, (uint)(h >> 32u), memory_order_relaxed);
+}
