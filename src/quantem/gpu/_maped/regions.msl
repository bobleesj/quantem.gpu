#include <metal_stdlib>
using namespace metal;

inline float dense_count_at(
    device const uchar *values, ulong item_bytes, device const uchar *valid,
    int r, int c, int d, int rows, int cols, int pixels,
    int first_row, int decoded_rows
) {
    if (r < 0 || r >= rows || c < 0 || c >= cols ||
        r < first_row || r >= first_row + decoded_rows || !valid[d]) return 0.0f;
    ulong index = (ulong(r - first_row) * ulong(cols) + ulong(c)) * ulong(pixels) + ulong(d);
    return item_bytes == 1 ? float(values[index]) :
        float(reinterpret_cast<device const ushort *>(values)[index]);
}

kernel void maped_sample_dense(
    device const uchar *values [[buffer(0)]],
    device const uchar *valid [[buffer(1)]],
    device float *output [[buffer(2)]],
    constant ulong *p [[buffer(3)]],
    constant float2 &shift [[buffer(4)]],
    uint item [[thread_position_in_grid]]
) {
    ulong total = p[1] * p[5];
    if (item >= total) return;
    int scan = int(p[0] + item / p[5]), d = int(item % p[5]);
    float rr = -shift.x, cc = -shift.y;
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    float rf = rr - float(r0), cf = cc - float(c0), sum = 0.0f;
    for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
        float weight = (dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf);
        float value = dense_count_at(
            values, p[6], valid, scan / int(p[3]) + r0 + dr,
            scan % int(p[3]) + c0 + dc, d, int(p[2]), int(p[3]),
            int(p[5]), int(p[7]), int(p[8])
        );
        sum = fma(value, weight, sum);
    }
    output[item] = sum;
}

inline float bilinear_window(int scan, int rows, int cols, float2 shift) {
    int row = scan / cols, col = scan % cols;
    float rr = float(row) - shift.x, cc = float(col) - shift.y;
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    float rf = rr - float(r0), cf = cc - float(c0), sum = 0.0f;
    for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
        int r = r0 + dr, c = c0 + dc;
        if (r <= 0 || r >= rows - 1 || c <= 0 || c >= cols - 1) continue;
        sum = fma((dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf), 1.0f, sum);
    }
    return sum;
}

inline float bilinear_detector_weight(int r, int c, int height, int width, float2 shift) {
    float rr = -shift.x * float(height - 1) / float(height);
    float cc = -shift.y * float(width - 1) / float(width);
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    float rf = rr - float(r0), cf = cc - float(c0), sum = 0.0f;
    for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
        int sr = r + r0 + dr, sc = c + c0 + dc;
        if (sr < 0 || sr >= height || sc < 0 || sc >= width) continue;
        sum = fma((dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf), 1.0f, sum);
    }
    return clamp(sum, 0.0f, 1.0f);
}

kernel void maped_accumulate(
    device const float *sample [[buffer(0)]],
    device float *numerator [[buffer(1)]],
    constant ulong *p [[buffer(2)]],
    constant float2 &real_shift [[buffer(3)]],
    constant float2 &diffraction_shift [[buffer(4)]],
    uint item [[thread_position_in_grid]]
) {
    ulong pixels = p[4] * p[5], total = p[1] * pixels;
    if (item >= total) return;
    int local_scan = int(item / pixels), d = int(item % pixels);
    int r = d / int(p[5]), c = d % int(p[5]);
    float rr = -diffraction_shift.x * float(p[4] - 1) / float(p[4]);
    float cc = -diffraction_shift.y * float(p[5] - 1) / float(p[5]);
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    float rf = rr - float(r0), cf = cc - float(c0), sum = 0.0f;
    for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
        int sr = r + r0 + dr, sc = c + c0 + dc;
        if (sr < 0 || sr >= int(p[4]) || sc < 0 || sc >= int(p[5])) continue;
        float weight = (dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf);
        sum = fma(sample[ulong(local_scan) * pixels + ulong(sr) * p[5] + ulong(sc)], weight, sum);
    }
    float wi = bilinear_window(int(p[0]) + local_scan, int(p[2]), int(p[3]), real_shift);
    numerator[item] = fma(wi, sum, numerator[item]);
}

kernel void maped_normalize(
    device float *values [[buffer(0)]],
    device const float2 *real_shifts [[buffer(1)]],
    device const float2 *diffraction_shifts [[buffer(2)]],
    constant ulong *p [[buffer(3)]],
    uint item [[thread_position_in_grid]]
) {
    ulong pixels = p[4] * p[5], total = p[1] * pixels;
    if (item >= total) return;
    int local_scan = int(item / pixels), d = int(item % pixels);
    int r = d / int(p[5]), c = d % int(p[5]);
    float denominator = 0.0f, detector_sum = 0.0f;
    for (ulong source = 0; source < p[6]; ++source) {
        float wd = bilinear_detector_weight(
            r, c, int(p[4]), int(p[5]), diffraction_shifts[source]
        );
        float wi = bilinear_window(
            int(p[0]) + local_scan, int(p[2]), int(p[3]), real_shifts[source]
        );
        denominator = fma(wi, wd, denominator);
        detector_sum += wd;
    }
    denominator += 1.0f - clamp(detector_sum, 0.0f, 1.0f);
    values[item] = denominator == 0.0f ? 0.0f : values[item] / denominator;
}
