#include <metal_stdlib>
using namespace metal;

constant uint MAPED_PIXELS_PER_THREAD = 4;

inline float dense_count_at(
    device const uchar *values, ulong item_bytes, device const uchar *valid,
    int r, int c, int d, int rows, int cols, int pixels,
    int first_row, int decoded_rows
) {
    if (r < 0 || r >= rows || c < 0 || c >= cols ||
        r < first_row || r >= first_row + decoded_rows || !valid[d]) return 0.0f;
    ulong index = (ulong(r - first_row) * ulong(cols) + ulong(c)) * ulong(pixels) + ulong(d);
    return item_bytes == 1 ? float(values[index]) :
        float(reinterpret_cast<device const ushort *>(values)[index]);
}

kernel void maped_sample_dense(
    device const uchar *values [[buffer(0)]],
    device const uchar *valid [[buffer(1)]],
    device const float4 *sampling [[buffer(2)]],
    device float *output [[buffer(3)]],
    constant ulong *p [[buffer(4)]],
    uint item [[thread_position_in_grid]]
) {
    ulong vectors = (p[5] + MAPED_PIXELS_PER_THREAD - 1) / MAPED_PIXELS_PER_THREAD;
    ulong total = p[1] * vectors;
    if (item >= total) return;
    int local_scan = int(item / vectors);
    int first_d = int(item % vectors) * int(MAPED_PIXELS_PER_THREAD);
    float4 map = sampling[p[9] * p[10] + p[0] + local_scan];
    int r0 = int(map.x), c0 = int(map.y);
    float rf = map.z, cf = map.w;
    for (int lane = 0; lane < int(MAPED_PIXELS_PER_THREAD); ++lane) {
        int d = first_d + lane;
        if (d >= int(p[5])) continue;
        float sum = 0.0f;
        for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
            float weight = (dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf);
            float value = dense_count_at(
                values, p[6], valid, r0 + dr,
                c0 + dc, d, int(p[2]), int(p[3]),
                int(p[5]), int(p[7]), int(p[8])
            );
            sum = fma(value, weight, sum);
        }
        output[ulong(local_scan) * p[5] + ulong(d)] = sum;
    }
}

inline float bilinear_window(int scan, int rows, int cols, float2 shift) {
    int row = scan / cols, col = scan % cols;
    float rr = float(row) - shift.x, cc = float(col) - shift.y;
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    float rf = rr - float(r0), cf = cc - float(c0), sum = 0.0f;
    for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
        int r = r0 + dr, c = c0 + dc;
        if (r <= 0 || r >= rows - 1 || c <= 0 || c >= cols - 1) continue;
        sum = fma((dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf), 1.0f, sum);
    }
    return sum;
}

kernel void maped_real_weights(
    device const float2 *shifts [[buffer(0)]],
    device float *weights [[buffer(1)]],
    device float4 *sampling [[buffer(2)]],
    constant ulong *p [[buffer(3)]],
    uint item [[thread_position_in_grid]]
) {
    ulong scans = p[1];
    if (item >= p[0] * scans) return;
    uint source = item / scans;
    uint scan = item - source * scans;
    float2 shift = shifts[source];
    int row = scan / uint(p[3]), col = scan % uint(p[3]);
    float rr = -shift.x, cc = -shift.y;
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    sampling[item] = float4(
        float(row + r0), float(col + c0), rr - float(r0), cc - float(c0)
    );
    weights[item] = bilinear_window(scan, int(p[2]), int(p[3]), shift);
}

kernel void maped_detector_weights(
    device const float2 *shifts [[buffer(0)]],
    device float *weights [[buffer(1)]],
    device int4 *sample_indices [[buffer(2)]],
    device float4 *sample_weights [[buffer(3)]],
    constant ulong *p [[buffer(4)]],
    uint item [[thread_position_in_grid]]
) {
    ulong pixels = p[1];
    if (item >= p[0] * pixels) return;
    uint source = item / pixels;
    uint d = item - source * pixels;
    int height = int(p[2]), width = int(p[3]);
    int r = d / uint(width), c = d % uint(width);
    float2 shift = shifts[source];
    float rr = -shift.x * float(height - 1) / float(height);
    float cc = -shift.y * float(width - 1) / float(width);
    int r0 = int(floor(rr)), c0 = int(floor(cc));
    float rf = rr - float(r0), cf = cc - float(c0), coverage = 0.0f;
    int4 indices = int4(0);
    float4 interpolation = float4(0.0f);
    for (int dr = 0; dr < 2; ++dr) for (int dc = 0; dc < 2; ++dc) {
        int lane = 2 * dr + dc;
        int sr = r + r0 + dr, sc = c + c0 + dc;
        if (sr < 0 || sr >= height || sc < 0 || sc >= width) continue;
        float value = (dr ? rf : 1.0f - rf) * (dc ? cf : 1.0f - cf);
        indices[lane] = sr * width + sc;
        interpolation[lane] = value;
        coverage += value;
    }
    weights[item] = clamp(coverage, 0.0f, 1.0f);
    sample_indices[item] = indices;
    sample_weights[item] = interpolation;
}

kernel void maped_detector_edge(
    device const float *weights [[buffer(0)]],
    device float *edge [[buffer(1)]],
    constant ulong *p [[buffer(2)]],
    uint pixel [[thread_position_in_grid]]
) {
    if (pixel >= p[1]) return;
    float total = 0.0f;
    for (ulong source = 0; source < p[0]; ++source)
        total += weights[source * p[1] + pixel];
    edge[pixel] = 1.0f - clamp(total, 0.0f, 1.0f);
}

kernel void maped_accumulate(
    device const float *sample [[buffer(0)]],
    device float *numerator [[buffer(1)]],
    device const float *real_weights [[buffer(2)]],
    device const int4 *sample_indices [[buffer(3)]],
    device const float4 *sample_weights [[buffer(4)]],
    constant ulong *p [[buffer(5)]],
    uint item [[thread_position_in_grid]]
) {
    ulong pixels = p[4] * p[5];
    ulong vectors = (pixels + MAPED_PIXELS_PER_THREAD - 1) / MAPED_PIXELS_PER_THREAD;
    ulong total = p[1] * vectors;
    if (item >= total) return;
    int local_scan = int(item / vectors);
    int first_d = int(item % vectors) * int(MAPED_PIXELS_PER_THREAD);
    ulong sample_base = ulong(local_scan) * pixels;
    float wi = real_weights[p[6] * p[7] + p[0] + local_scan];
    for (int output_lane = 0;
         output_lane < int(MAPED_PIXELS_PER_THREAD); ++output_lane) {
        int d = first_d + output_lane;
        if (d >= int(pixels)) continue;
        ulong map_index = p[6] * p[8] + d;
        int4 indices = sample_indices[map_index];
        float4 weights = sample_weights[map_index];
        float sum = 0.0f;
        for (int lane = 0; lane < 4; ++lane)
            sum = fma(sample[sample_base + ulong(indices[lane])], weights[lane], sum);
        ulong output = sample_base + ulong(d);
        numerator[output] = p[6] == 0
            ? wi * sum : fma(wi, sum, numerator[output]);
    }
}

kernel void maped_normalize(
    device float *values [[buffer(0)]],
    device const float *real_weights [[buffer(1)]],
    device const float *detector_weights [[buffer(2)]],
    device const float *detector_edge [[buffer(3)]],
    constant ulong *p [[buffer(4)]],
    uint item [[thread_position_in_grid]]
) {
    ulong pixels = p[4] * p[5];
    ulong vectors = (pixels + MAPED_PIXELS_PER_THREAD - 1) / MAPED_PIXELS_PER_THREAD;
    ulong total = p[1] * vectors;
    if (item >= total) return;
    int local_scan = int(item / vectors);
    int first_d = int(item % vectors) * int(MAPED_PIXELS_PER_THREAD);
    for (int lane = 0; lane < int(MAPED_PIXELS_PER_THREAD); ++lane) {
        int d = first_d + lane;
        if (d >= int(pixels)) continue;
        float denominator = 0.0f;
        for (ulong source = 0; source < p[6]; ++source) {
            float wd = detector_weights[source * p[8] + d];
            float wi = real_weights[source * p[7] + p[0] + local_scan];
            denominator = fma(wi, wd, denominator);
        }
        denominator += detector_edge[d];
        ulong output = ulong(local_scan) * pixels + ulong(d);
        values[output] = denominator == 0.0f ? 0.0f : values[output] / denominator;
    }
}
