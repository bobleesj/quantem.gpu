#include <metal_stdlib>
using namespace metal;

// IMPORTANT: All frame-indexed address calculations use ulong casts to
// prevent uint32 overflow. Without this, frame_id * frame_bytes overflows
// at frame ~58K for 73,728-byte frames (58255 × 73728 = 4,295,024,640 > 2^32),
// causing all subsequent frames to read/write address 0 and produce zeros.

// ---- LZ4 decompression constants ----
constant uint DECOMP_THREADS_PER_CHUNK = 32;
constant uint DECOMP_INPUT_BUFFER_SIZE = 256;  // 32 * sizeof(ulong)
constant uint DECOMP_BUFFER_PREFETCH_DIST = 128;

inline void syncCTA() {
    simdgroup_barrier(mem_flags::mem_threadgroup);
}

inline ushort readWordDevice(const device uchar* address) {
    return ushort(address[0]) | (ushort(address[1]) << 8);
}
inline ushort readWordTG(threadgroup const uchar* address) {
    return ushort(address[0]) | (ushort(address[1]) << 8);
}

struct token_type { uint num_literals; uint num_matches; };

inline token_type decodePair(uchar num) {
    return token_type{uint((num & 0xf0) >> 4), uint(num & 0x0f)};
}

// ---- Cooperative copy functions ----
inline void coopCopyNoOverlap(
    device uchar* dest, const device uchar* source,
    uint length, uint tid, uint stride
) {
    for (uint i = tid; i < length; i += stride)
        dest[i] = source[i];
}
inline void coopCopyNoOverlapFromTG(
    device uchar* dest, threadgroup const uchar* source,
    uint length, uint tid, uint stride
) {
    for (uint i = tid; i < length; i += stride)
        dest[i] = source[i];
}
inline void coopCopyRepeat(
    device uchar* dest, const device uchar* source,
    uint dist, uint length, uint tid, uint stride
) {
    for (uint i = tid; i < length; i += stride)
        dest[i] = source[i % dist];
}
inline void coopCopyRepeatFromTG(
    device uchar* dest, threadgroup const uchar* source,
    uint dist, uint length, uint tid, uint stride
) {
    for (uint i = tid; i < length; i += stride)
        dest[i] = source[i % dist];
}
inline void coopCopyOverlap(
    device uchar* dest, const device uchar* source,
    uint dist, uint length, uint tid, uint stride
) {
    if (dist < length) coopCopyRepeat(dest, source, dist, length, tid, stride);
    else               coopCopyNoOverlap(dest, source, length, tid, stride);
}
inline void coopCopyOverlapFromTG(
    device uchar* dest, threadgroup const uchar* source,
    uint dist, uint length, uint tid, uint stride
) {
    if (dist < length) coopCopyRepeatFromTG(dest, source, dist, length, tid, stride);
    else               coopCopyNoOverlapFromTG(dest, source, length, tid, stride);
}

// ---- Buffer load: fill threadgroup cache from device memory ----
inline void bufferLoadAt(
    threadgroup uchar* buffer,
    const device uchar* compData,
    uint comp_length,
    thread long& buf_offset,
    uint tid
) {
    ulong addr = ulong(compData) + ulong(buf_offset);
    ulong aligned = (addr / 8) * 8;
    buf_offset = long(aligned - ulong(compData));
    if (uint(buf_offset) + DECOMP_INPUT_BUFFER_SIZE <= comp_length) {
        const device ulong* src = (const device ulong*)(compData + buf_offset);
        threadgroup ulong* dst = (threadgroup ulong*)buffer;
        dst[tid] = src[tid];
    } else {
        for (uint i = tid; i < DECOMP_INPUT_BUFFER_SIZE; i += DECOMP_THREADS_PER_CHUNK) {
            if (uint(buf_offset) + i < comp_length)
                buffer[i] = compData[buf_offset + i];
        }
    }
    syncCTA();
}

inline uint readLSIC(
    threadgroup const uchar* buffer,
    const device uchar* compData,
    long buf_offset, uint buf_end,
    thread uint& idx
) {
    uint num = 0;
    uchar next = 0xff;
    while (next == 0xff && idx < buf_end) {
        next = buffer[idx - uint(buf_offset)];
        idx++;
        num += next;
    }
    while (next == 0xff) {
        next = compData[idx];
        idx++;
        num += next;
    }
    return num;
}

inline void decompressStream(
    threadgroup uchar* buffer,
    device uchar* decompData,
    const device uchar* compData,
    uint comp_end,
    uint tid
) {
    long buf_offset = 0;
    bufferLoadAt(buffer, compData, comp_end, buf_offset, tid);
    uint decomp_idx = 0;
    uint comp_idx = 0;
    while (comp_idx < comp_end) {
        uint buf_end = uint(buf_offset) + DECOMP_INPUT_BUFFER_SIZE;
        if (comp_idx + DECOMP_BUFFER_PREFETCH_DIST > buf_end) {
            buf_offset = long(comp_idx);
            bufferLoadAt(buffer, compData, comp_end, buf_offset, tid);
        }
        buf_end = uint(buf_offset) + DECOMP_INPUT_BUFFER_SIZE;
        token_type tok = decodePair(buffer[comp_idx - uint(buf_offset)]);
        comp_idx++;
        uint num_literals = tok.num_literals;
        if (tok.num_literals == 15)
            num_literals += readLSIC(buffer, compData, buf_offset, buf_end, comp_idx);
        uint literalStart = comp_idx;
        if (num_literals + comp_idx > buf_end)
            coopCopyNoOverlap(decompData + decomp_idx, compData + comp_idx,
                              num_literals, tid, DECOMP_THREADS_PER_CHUNK);
        else
            coopCopyNoOverlapFromTG(decompData + decomp_idx,
                                    buffer + (comp_idx - uint(buf_offset)),
                                    num_literals, tid, DECOMP_THREADS_PER_CHUNK);
        comp_idx += num_literals;
        decomp_idx += num_literals;
        if (comp_idx < comp_end) {
            ushort match_offset;
            if (comp_idx + 2 > buf_end)
                match_offset = readWordDevice(compData + comp_idx);
            else
                match_offset = readWordTG(buffer + (comp_idx - uint(buf_offset)));
            comp_idx += 2;
            uint match_len = 4 + tok.num_matches;
            if (tok.num_matches == 15)
                match_len += readLSIC(buffer, compData, buf_offset, buf_end, comp_idx);
            if (match_offset <= num_literals
                && (long(literalStart) >= buf_offset
                    && literalStart + num_literals <= buf_end)) {
                coopCopyOverlapFromTG(
                    decompData + decomp_idx,
                    buffer + (literalStart + (num_literals - match_offset) - uint(buf_offset)),
                    match_offset, match_len, tid, DECOMP_THREADS_PER_CHUNK);
                syncCTA();
            } else {
                syncCTA();
                coopCopyOverlap(
                    decompData + decomp_idx,
                    decompData + decomp_idx - match_offset,
                    match_offset, match_len, tid, DECOMP_THREADS_PER_CHUNK);
            }
            decomp_idx += match_len;
        }
    }
}

inline uint read32be(const device uchar* p) {
    return (uint(p[0]) << 24) | (uint(p[1]) << 16) | (uint(p[2]) << 8) | uint(p[3]);
}

// =====================================================================
// Kernel 1: Batched LZ4 decompression
// Grid:  (n_frames, 1, (max_blocks+1)/2)
// Block: (32, 2, 1)
// =====================================================================
kernel void h5lz4dc_batched(
    const device uchar* compressed          [[buffer(0)]],
    const device uint*  chunk_offsets        [[buffer(1)]],
    const device uint*  block_starts         [[buffer(2)]],
    const device uint*  block_counts         [[buffer(3)]],
    const device uint*  block_offsets        [[buffer(4)]],
    constant uint&      blocksize            [[buffer(5)]],
    constant uint&      frame_bytes          [[buffer(6)]],
    device uchar*       decompressed         [[buffer(7)]],
    uint3 tpig  [[threadgroup_position_in_grid]],
    uint3 tpit  [[thread_position_in_threadgroup]],
    uint3 tptg  [[threads_per_threadgroup]]
) {
    uint frame_id       = tpig.x;
    uint block_in_frame = tpig.z * tptg.y + tpit.y;
    uint chunk_offset   = chunk_offsets[frame_id];
    uint block_offset   = block_offsets[frame_id];
    uint num_blocks     = block_counts[frame_id];
    threadgroup uchar tg_buffer[256 * LZ4_BLOCKS_PER_TG];
    if (block_in_frame < num_blocks) {
        uint blk_start = block_starts[block_offset + block_in_frame];
        const device uchar* input = compressed + chunk_offset + blk_start + 4;
        uint comp_size = read32be(compressed + chunk_offset + blk_start);
        device uchar* output = decompressed + ulong(frame_id) * ulong(frame_bytes)
                               + block_in_frame * blocksize;
        decompressStream(tg_buffer + tpit.y * 256, output, input, comp_size, tpit.x);
    }
}

// =====================================================================
// Kernel 2a: Batched bitshuffle unshuffle (8192-byte blocks, 32-bit elems)
//
// Optimized: 32 SIMD groups per threadgroup (1024 threads), each group
// unshuffles 32 elements using shared memory to cache bit planes.
//
// Grid:  (n_frames, 1, ceil(total_groups / 32))
// Block: (32, 32, 1)  →  32 SIMD groups of 32 threads
// =====================================================================
kernel void shuf_8192_32_batched(
    const device uint*  in   [[buffer(0)]],
    device uint*        out  [[buffer(1)]],
    constant uint&      frame_u32s        [[buffer(2)]],
    constant uint&      groups_per_block  [[buffer(3)]],
    constant uint&      total_groups      [[buffer(4)]],
    uint3 tpig       [[threadgroup_position_in_grid]],
    uint  lane       [[thread_index_in_simdgroup]],
    uint  sg_id      [[simdgroup_index_in_threadgroup]]
) {
    uint frame_id  = tpig.x;
    uint group_id  = tpig.z * 32 + sg_id;
    if (group_id >= total_groups) return;
    uint block_id       = group_id / groups_per_block;
    uint group_in_block = group_id % groups_per_block;
    const device uint* block_in = in + ulong(frame_id) * ulong(frame_u32s)
                                     + block_id * 2048;
    // Cache 32 bit planes in shared memory (one set per SIMD group)
    threadgroup uint planes[32][32];
    planes[sg_id][lane] = block_in[lane * groups_per_block + group_in_block];
    simdgroup_barrier(mem_flags::mem_threadgroup);
    uint result = 0;
    for (int j = 0; j < 32; j++)
        if (planes[sg_id][j] & (1U << lane))
            result |= (1U << j);
    out[ulong(frame_id) * ulong(frame_u32s) + group_id * 32 + lane] = result;
}

// =====================================================================
// Kernel 2b: Batched bitshuffle unshuffle (8192-byte blocks, 16-bit elems)
//
// Optimized: 32 SIMD groups per threadgroup (1024 threads), each group
// unshuffles 32 elements using shared memory to cache bit planes.
// 32x fewer threadgroup launches vs one-group-per-threadgroup version.
//
// Grid:  (n_frames, 1, ceil(groups_per_frame / 32))
// Block: (32, 32, 1)  →  32 SIMD groups of 32 threads
// =====================================================================
kernel void shuf_8192_16_batched(
    const device uint*  in   [[buffer(0)]],
    device ushort*      out  [[buffer(1)]],
    constant uint&      frame_u16s        [[buffer(2)]],
    constant uint&      groups_per_block  [[buffer(3)]],
    constant uint&      total_groups      [[buffer(4)]],
    uint3 tpig       [[threadgroup_position_in_grid]],
    uint  lane       [[thread_index_in_simdgroup]],
    uint  sg_id      [[simdgroup_index_in_threadgroup]]
) {
    uint frame_id  = tpig.x;
    uint group_id  = tpig.z * 32 + sg_id;

    if (group_id >= total_groups) return;

    uint block_id       = group_id / groups_per_block;
    uint group_in_block = group_id % groups_per_block;

    const device uint* block_in = in + ulong(frame_id) * ulong(frame_u16s / 2)
                                     + block_id * 2048;

    // Cache 16 bit planes in shared memory (one set per SIMD group)
    threadgroup uint planes[32][16];
    if (lane < 16)
        planes[sg_id][lane] = block_in[lane * groups_per_block + group_in_block];
    simdgroup_barrier(mem_flags::mem_threadgroup);

    ushort result = 0;
    for (int j = 0; j < 16; j++)
        if (planes[sg_id][j] & (1U << lane))
            result |= ushort(1U << j);

    out[ulong(frame_id) * ulong(frame_u16s) + group_id * 32 + lane] = result;
}

// Lossless-browse variant: unshuffle uint16 and saturate directly to uint8.
// This avoids materializing and rereading a full uint16 scratch stack when no
// bad-pixel operation must run between unshuffle and narrowing.
kernel void shuf_8192_16_to_u8_batched(
    const device uint*  in   [[buffer(0)]],
    device uchar*       out  [[buffer(1)]],
    constant uint&      frame_u16s        [[buffer(2)]],
    constant uint&      groups_per_block  [[buffer(3)]],
    constant uint&      total_groups      [[buffer(4)]],
    uint3 tpig       [[threadgroup_position_in_grid]],
    uint  lane       [[thread_index_in_simdgroup]],
    uint  sg_id      [[simdgroup_index_in_threadgroup]]
) {
    uint frame_id = tpig.x;
    uint group_id = tpig.z * 32 + sg_id;
    if (group_id >= total_groups) return;

    uint block_id = group_id / groups_per_block;
    uint group_in_block = group_id % groups_per_block;
    const device uint* block_in = in + ulong(frame_id) * ulong(frame_u16s / 2)
                                     + block_id * 2048;
    threadgroup uint planes[32][16];
    if (lane < 16)
        planes[sg_id][lane] = block_in[lane * groups_per_block + group_in_block];
    simdgroup_barrier(mem_flags::mem_threadgroup);

    ushort result = 0;
    for (int j = 0; j < 16; j++)
        if (planes[sg_id][j] & (1U << lane))
            result |= ushort(1U << j);
    out[ulong(frame_id) * ulong(frame_u16s) + group_id * 32 + lane]
        = uchar(min(result, ushort(255)));
}

// Dead-pixel-corrected lossless-browse variant. The detector mask is shared by
// every frame, so the unshuffle lane can zero a bad pixel before writing the
// clipped uint8 result. This preserves mask-before-narrow semantics without a
// full uint16 scratch stack and separate zero/clip dispatches.
kernel void shuf_8192_16_to_u8_masked_batched(
    const device uint*  in    [[buffer(0)]],
    device uchar*       out   [[buffer(1)]],
    constant uint&      frame_u16s        [[buffer(2)]],
    constant uint&      groups_per_block  [[buffer(3)]],
    constant uint&      total_groups      [[buffer(4)]],
    const device uchar* mask  [[buffer(5)]],
    uint3 tpig       [[threadgroup_position_in_grid]],
    uint  lane       [[thread_index_in_simdgroup]],
    uint  sg_id      [[simdgroup_index_in_threadgroup]]
) {
    uint frame_id = tpig.x;
    uint group_id = tpig.z * 32 + sg_id;
    if (group_id >= total_groups) return;

    uint block_id = group_id / groups_per_block;
    uint group_in_block = group_id % groups_per_block;
    const device uint* block_in = in + ulong(frame_id) * ulong(frame_u16s / 2)
                                     + block_id * 2048;
    threadgroup uint planes[32][16];
    if (lane < 16)
        planes[sg_id][lane] = block_in[lane * groups_per_block + group_in_block];
    simdgroup_barrier(mem_flags::mem_threadgroup);

    ushort result = 0;
    for (int j = 0; j < 16; j++)
        if (planes[sg_id][j] & (1U << lane))
            result |= ushort(1U << j);
    uint detector_index = group_id * 32 + lane;
    out[ulong(frame_id) * ulong(frame_u16s) + detector_index]
        = mask[detector_index] ? uchar(0) : uchar(min(result, ushort(255)));
}

// Final partial-block unshuffle. This is the Metal port of QuantEM.GPU's
// canonical CUDA tail kernels: the shortened block uses its actual bit-plane
// stride instead of the complete 8192-byte block stride. The host admits only
// tails containing a multiple of eight elements.
kernel void shuf_tail_16_batched(
    const device uchar* in          [[buffer(0)]],
    device ushort*      out         [[buffer(1)]],
    constant uint&      frame_bytes [[buffer(2)]],
    uint3 group_position            [[threadgroup_position_in_grid]],
    uint thread_index               [[thread_index_in_threadgroup]]
) {
    uint tail_bytes = frame_bytes % 8192u;
    if (tail_bytes == 0u) return;
    uint frame = group_position.x;
    uint full_blocks = frame_bytes / 8192u;
    uint tail_elements = tail_bytes / 2u;
    uint bitplane_bytes = tail_elements / 8u;
    uint element = group_position.z * 256u + thread_index;
    if (element >= tail_elements) return;

    const device uchar* block = in
        + ulong(frame) * ulong(frame_bytes)
        + ulong(full_blocks) * 8192u;
    uint byte_in_plane = element / 8u;
    uint bit_in_byte = element % 8u;
    ushort value = 0u;
    for (uint bit = 0u; bit < 16u; ++bit) {
        if (block[ulong(bit) * bitplane_bytes + byte_in_plane]
            & (1u << bit_in_byte)) {
            value |= ushort(1u << bit);
        }
    }
    out[ulong(frame) * ulong(frame_bytes / 2u)
        + ulong(full_blocks) * 4096u + element] = value;
}

kernel void shuf_tail_32_batched(
    const device uchar* in          [[buffer(0)]],
    device uint*        out         [[buffer(1)]],
    constant uint&      frame_bytes [[buffer(2)]],
    uint3 group_position            [[threadgroup_position_in_grid]],
    uint thread_index               [[thread_index_in_threadgroup]]
) {
    uint tail_bytes = frame_bytes % 8192u;
    if (tail_bytes == 0u) return;
    uint frame = group_position.x;
    uint full_blocks = frame_bytes / 8192u;
    uint tail_elements = tail_bytes / 4u;
    uint bitplane_bytes = tail_elements / 8u;
    uint element = group_position.z * 256u + thread_index;
    if (element >= tail_elements) return;

    const device uchar* block = in
        + ulong(frame) * ulong(frame_bytes)
        + ulong(full_blocks) * 8192u;
    uint byte_in_plane = element / 8u;
    uint bit_in_byte = element % 8u;
    uint value = 0u;
    for (uint bit = 0u; bit < 32u; ++bit) {
        if (block[ulong(bit) * bitplane_bytes + byte_in_plane]
            & (1u << bit_in_byte)) {
            value |= 1u << bit;
        }
    }
    out[ulong(frame) * ulong(frame_bytes / 4u)
        + ulong(full_blocks) * 2048u + element] = value;
}

kernel void shuf_tail_16_to_u8_batched(
    const device uchar* in          [[buffer(0)]],
    device uchar*       out         [[buffer(1)]],
    constant uint&      frame_bytes [[buffer(2)]],
    uint3 group_position            [[threadgroup_position_in_grid]],
    uint thread_index               [[thread_index_in_threadgroup]]
) {
    uint tail_bytes = frame_bytes % 8192u;
    if (tail_bytes == 0u) return;
    uint frame = group_position.x;
    uint full_blocks = frame_bytes / 8192u;
    uint tail_elements = tail_bytes / 2u;
    uint bitplane_bytes = tail_elements / 8u;
    uint element = group_position.z * 256u + thread_index;
    if (element >= tail_elements) return;

    const device uchar* block = in
        + ulong(frame) * ulong(frame_bytes)
        + ulong(full_blocks) * 8192u;
    uint byte_in_plane = element / 8u;
    uint bit_in_byte = element % 8u;
    ushort value = 0u;
    for (uint bit = 0u; bit < 16u; ++bit) {
        if (block[ulong(bit) * bitplane_bytes + byte_in_plane]
            & (1u << bit_in_byte)) {
            value |= ushort(1u << bit);
        }
    }
    out[ulong(frame) * ulong(frame_bytes / 2u)
        + ulong(full_blocks) * 4096u + element]
        = uchar(min(value, ushort(255)));
}

kernel void shuf_tail_16_to_u8_masked_batched(
    const device uchar* in          [[buffer(0)]],
    device uchar*       out         [[buffer(1)]],
    constant uint&      frame_bytes [[buffer(2)]],
    const device uchar* mask        [[buffer(3)]],
    uint3 group_position            [[threadgroup_position_in_grid]],
    uint thread_index               [[thread_index_in_threadgroup]]
) {
    uint tail_bytes = frame_bytes % 8192u;
    if (tail_bytes == 0u) return;
    uint frame = group_position.x;
    uint full_blocks = frame_bytes / 8192u;
    uint tail_elements = tail_bytes / 2u;
    uint bitplane_bytes = tail_elements / 8u;
    uint element = group_position.z * 256u + thread_index;
    if (element >= tail_elements) return;

    const device uchar* block = in
        + ulong(frame) * ulong(frame_bytes)
        + ulong(full_blocks) * 8192u;
    uint byte_in_plane = element / 8u;
    uint bit_in_byte = element % 8u;
    ushort value = 0u;
    for (uint bit = 0u; bit < 16u; ++bit) {
        if (block[ulong(bit) * bitplane_bytes + byte_in_plane]
            & (1u << bit_in_byte)) {
            value |= ushort(1u << bit);
        }
    }
    uint detector_pixel = full_blocks * 4096u + element;
    out[ulong(frame) * ulong(frame_bytes / 2u) + detector_pixel]
        = mask[detector_pixel] == 0u ? uchar(min(value, ushort(255))) : 0u;
}

// Fused generic uint16 bit-unshuffle + exact detector sum-bin. A 256-thread
// group reconstructs one 8x16 output tile from bit-plane words into a bounded
// threadgroup tile, then sums each explicit BxB detector region. This removes
// the full-resolution global-memory write/read between unshuffle and binning.
// The caller uses this path only for B in {2,4,8}, detector widths divisible by
// 32, and complete 8192-byte bitshuffle blocks; other layouts retain the
// established two-kernel path.
kernel void shuf_bin_sum_8192_16_batched(
    const device uint*  in             [[buffer(0)]],
    device ushort*      out            [[buffer(1)]],
    const device uchar* mask           [[buffer(2)]],
    constant uint&      in_rows        [[buffer(3)]],
    constant uint&      in_cols        [[buffer(4)]],
    constant uint&      frame_u16s     [[buffer(5)]],
    constant uint&      out_rows       [[buffer(6)]],
    constant uint&      out_cols       [[buffer(7)]],
    constant uint&      bin_factor     [[buffer(8)]],
    device atomic_uint* overflow       [[buffer(9)]],
    uint3 group_position               [[threadgroup_position_in_grid]],
    uint thread_index                  [[thread_index_in_threadgroup]],
    uint lane                          [[thread_index_in_simdgroup]],
    uint simdgroup_index               [[simdgroup_index_in_threadgroup]]
) {
    constexpr uint output_tile_rows = 8u;
    constexpr uint output_tile_cols = 16u;
    constexpr uint simdgroups_per_threadgroup = 8u;
    constexpr uint groups_per_block = 128u;

    uint frame = group_position.x;
    uint input_tile_rows = output_tile_rows * bin_factor;
    uint input_tile_cols = output_tile_cols * bin_factor;
    uint input_origin_row = group_position.y * input_tile_rows;
    uint input_origin_col = group_position.z * input_tile_cols;
    uint row_word_groups = input_tile_cols / 32u;
    uint tile_word_groups = input_tile_rows * row_word_groups;

    // Maximum is bin8: (8*8) x (16*8) = 8192 uint16 values (16 KiB).
    threadgroup ushort tile[64u * 128u];
    threadgroup uint planes[simdgroups_per_threadgroup][16u];

    for (
        uint tile_group = simdgroup_index;
        tile_group < tile_word_groups;
        tile_group += simdgroups_per_threadgroup
    ) {
        uint local_row = tile_group / row_word_groups;
        uint local_word_group = tile_group - local_row * row_word_groups;
        uint source_row = input_origin_row + local_row;
        uint source_col = input_origin_col + local_word_group * 32u;
        bool valid_group = source_row < in_rows && source_col < in_cols;

        if (lane < 16u) {
            uint plane_word = 0u;
            if (valid_group) {
                uint source_pixel = source_row * in_cols + source_col;
                uint block = source_pixel >> 12u;
                uint group_in_block = (source_pixel & 4095u) >> 5u;
                const device uint* block_in = in
                    + ulong(frame) * ulong(frame_u16s / 2u)
                    + block * 2048u;
                plane_word = block_in[lane * groups_per_block + group_in_block];
            }
            planes[simdgroup_index][lane] = plane_word;
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);

        ushort value = 0u;
        for (uint bit = 0u; bit < 16u; ++bit) {
            if (planes[simdgroup_index][bit] & (1u << lane)) {
                value |= ushort(1u << bit);
            }
        }
        uint detector_col = source_col + lane;
        bool valid_pixel = valid_group && detector_col < in_cols;
        uint detector_pixel = source_row * in_cols + detector_col;
        if (!valid_pixel || mask[detector_pixel] != 0u) {
            value = 0u;
        }
        tile[local_row * input_tile_cols + local_word_group * 32u + lane] = value;
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (thread_index >= output_tile_rows * output_tile_cols) return;
    uint local_output_row = thread_index / output_tile_cols;
    uint local_output_col = thread_index - local_output_row * output_tile_cols;
    uint output_row = group_position.y * output_tile_rows + local_output_row;
    uint output_col = group_position.z * output_tile_cols + local_output_col;
    if (output_row >= out_rows || output_col >= out_cols) return;

    uint sum = 0u;
    uint tile_row = local_output_row * bin_factor;
    uint tile_col = local_output_col * bin_factor;
    for (uint row_offset = 0u; row_offset < bin_factor; ++row_offset) {
        for (uint col_offset = 0u; col_offset < bin_factor; ++col_offset) {
            sum += uint(
                tile[(tile_row + row_offset) * input_tile_cols
                     + tile_col + col_offset]
            );
        }
    }
    if (sum > 65535u) {
        atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
    }
    uint output_frame_elements = out_rows * out_cols;
    out[ulong(frame) * ulong(output_frame_elements) + output_row * out_cols
        + output_col] = ushort(min(sum, 65535u));
}

// Bin-2 specialization of the fused kernel above. Its 4 KiB input tile keeps
// substantially more threadgroups resident than the generic bin-8-sized tile.
// A 16x32 output tile lets each of 256 threads publish two fixed four-value
// sums and reduces the threadgroup grid to one quarter of the original 8x16
// layout.
kernel void shuf_bin2_sum_8192_16_batched(
    const device uint*  in             [[buffer(0)]],
    device ushort*      out            [[buffer(1)]],
    const device uchar* mask           [[buffer(2)]],
    constant uint&      in_rows        [[buffer(3)]],
    constant uint&      in_cols        [[buffer(4)]],
    constant uint&      frame_u16s     [[buffer(5)]],
    constant uint&      out_rows       [[buffer(6)]],
    constant uint&      out_cols       [[buffer(7)]],
    constant uint&      bin_factor     [[buffer(8)]],
    device atomic_uint* overflow       [[buffer(9)]],
    uint3 group_position               [[threadgroup_position_in_grid]],
    uint thread_index                  [[thread_index_in_threadgroup]],
    uint lane                          [[thread_index_in_simdgroup]],
    uint simdgroup_index               [[simdgroup_index_in_threadgroup]]
) {
    (void)bin_factor;
    constexpr uint input_tile_rows = 32u;
    constexpr uint input_tile_cols = 64u;
    constexpr uint row_word_groups = input_tile_cols / 32u;
    constexpr uint tile_word_groups = input_tile_rows * row_word_groups;
    constexpr uint groups_per_block = 128u;
    constexpr uint simdgroups_per_threadgroup = 8u;
    uint frame = group_position.x;
    uint input_origin_row = group_position.y * input_tile_rows;
    uint input_origin_col = group_position.z * input_tile_cols;
    threadgroup ushort tile[input_tile_rows * input_tile_cols];
    threadgroup uint planes[simdgroups_per_threadgroup][16u];

    for (
        uint tile_group = simdgroup_index;
        tile_group < tile_word_groups;
        tile_group += simdgroups_per_threadgroup
    ) {
        uint local_row = tile_group / row_word_groups;
        uint local_word_group = tile_group - local_row * row_word_groups;
        uint source_row = input_origin_row + local_row;
        uint source_col = input_origin_col + local_word_group * 32u;
        bool valid_group = source_row < in_rows && source_col < in_cols;
        if (lane < 16u) {
            uint plane_word = 0u;
            if (valid_group) {
                uint source_pixel = source_row * in_cols + source_col;
                uint block = source_pixel >> 12u;
                uint group_in_block = (source_pixel & 4095u) >> 5u;
                const device uint* block_in = in
                    + ulong(frame) * ulong(frame_u16s / 2u)
                    + block * 2048u;
                plane_word = block_in[lane * groups_per_block + group_in_block];
            }
            planes[simdgroup_index][lane] = plane_word;
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);

        ushort value = 0u;
        for (uint bit = 0u; bit < 16u; ++bit) {
            if (planes[simdgroup_index][bit] & (1u << lane)) {
                value |= ushort(1u << bit);
            }
        }
        uint detector_col = source_col + lane;
        bool valid_pixel = valid_group && detector_col < in_cols;
        uint detector_pixel = source_row * in_cols + detector_col;
        if (!valid_pixel || mask[detector_pixel] != 0u) {
            value = 0u;
        }
        tile[local_row * input_tile_cols + local_word_group * 32u + lane] = value;
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    constexpr uint output_tile_elements = 16u * 32u;
    for (
        uint output_index = thread_index;
        output_index < output_tile_elements;
        output_index += 256u
    ) {
        uint local_output_row = output_index / 32u;
        uint local_output_col = output_index - local_output_row * 32u;
        uint output_row = group_position.y * 16u + local_output_row;
        uint output_col = group_position.z * 32u + local_output_col;
        if (output_row >= out_rows || output_col >= out_cols) continue;
        uint tile_row = local_output_row * 2u;
        uint tile_col = local_output_col * 2u;
        uint first_row = tile_row * input_tile_cols + tile_col;
        uint second_row = first_row + input_tile_cols;
        uint sum = uint(tile[first_row]) + uint(tile[first_row + 1u])
            + uint(tile[second_row]) + uint(tile[second_row + 1u]);
        if (sum > 65535u) {
            atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
        }
        uint output_frame_elements = out_rows * out_cols;
        out[ulong(frame) * ulong(output_frame_elements) + output_row * out_cols
            + output_col] = ushort(min(sum, 65535u));
    }
}

// Bin-4 specialization of the generic fused kernel. The generic kernel must
// reserve a bin-8-sized 16 KiB detector tile at compile time. Bin 4 needs only
// a 32x64 input tile (4 KiB), which allows more resident threadgroups while
// preserving the same explicit uint32 accumulation and fail-closed uint16
// range check.
kernel void shuf_bin4_sum_8192_16_batched(
    const device uint*  in             [[buffer(0)]],
    device ushort*      out            [[buffer(1)]],
    const device uchar* mask           [[buffer(2)]],
    constant uint&      in_rows        [[buffer(3)]],
    constant uint&      in_cols        [[buffer(4)]],
    constant uint&      frame_u16s     [[buffer(5)]],
    constant uint&      out_rows       [[buffer(6)]],
    constant uint&      out_cols       [[buffer(7)]],
    constant uint&      bin_factor     [[buffer(8)]],
    device atomic_uint* overflow       [[buffer(9)]],
    uint3 group_position               [[threadgroup_position_in_grid]],
    uint thread_index                  [[thread_index_in_threadgroup]],
    uint lane                          [[thread_index_in_simdgroup]],
    uint simdgroup_index               [[simdgroup_index_in_threadgroup]]
) {
    (void)bin_factor;
    constexpr uint output_tile_rows = 8u;
    constexpr uint output_tile_cols = 16u;
    constexpr uint input_tile_rows = output_tile_rows * 4u;
    constexpr uint input_tile_cols = output_tile_cols * 4u;
    constexpr uint row_word_groups = input_tile_cols / 32u;
    constexpr uint tile_word_groups = input_tile_rows * row_word_groups;
    constexpr uint groups_per_block = 128u;
    constexpr uint simdgroups_per_threadgroup = 8u;

    uint frame = group_position.x;
    uint input_origin_row = group_position.y * input_tile_rows;
    uint input_origin_col = group_position.z * input_tile_cols;
    threadgroup ushort tile[input_tile_rows * input_tile_cols];
    threadgroup uint planes[simdgroups_per_threadgroup][16u];

    for (
        uint tile_group = simdgroup_index;
        tile_group < tile_word_groups;
        tile_group += simdgroups_per_threadgroup
    ) {
        uint local_row = tile_group / row_word_groups;
        uint local_word_group = tile_group - local_row * row_word_groups;
        uint source_row = input_origin_row + local_row;
        uint source_col = input_origin_col + local_word_group * 32u;
        bool valid_group = source_row < in_rows && source_col < in_cols;

        if (lane < 16u) {
            uint plane_word = 0u;
            if (valid_group) {
                uint source_pixel = source_row * in_cols + source_col;
                uint block = source_pixel >> 12u;
                uint group_in_block = (source_pixel & 4095u) >> 5u;
                const device uint* block_in = in
                    + ulong(frame) * ulong(frame_u16s / 2u)
                    + block * 2048u;
                plane_word = block_in[lane * groups_per_block + group_in_block];
            }
            planes[simdgroup_index][lane] = plane_word;
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);

        ushort value = 0u;
        for (uint bit = 0u; bit < 16u; ++bit) {
            if (planes[simdgroup_index][bit] & (1u << lane)) {
                value |= ushort(1u << bit);
            }
        }
        uint detector_col = source_col + lane;
        bool valid_pixel = valid_group && detector_col < in_cols;
        uint detector_pixel = source_row * in_cols + detector_col;
        if (!valid_pixel || mask[detector_pixel] != 0u) {
            value = 0u;
        }
        tile[local_row * input_tile_cols + local_word_group * 32u + lane] = value;
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (thread_index >= output_tile_rows * output_tile_cols) return;
    uint local_output_row = thread_index / output_tile_cols;
    uint local_output_col = thread_index - local_output_row * output_tile_cols;
    uint output_row = group_position.y * output_tile_rows + local_output_row;
    uint output_col = group_position.z * output_tile_cols + local_output_col;
    if (output_row >= out_rows || output_col >= out_cols) return;

    uint tile_row = local_output_row * 4u;
    uint tile_col = local_output_col * 4u;
    uint sum = 0u;
    for (uint row_offset = 0u; row_offset < 4u; ++row_offset) {
        for (uint col_offset = 0u; col_offset < 4u; ++col_offset) {
            sum += uint(
                tile[(tile_row + row_offset) * input_tile_cols
                     + tile_col + col_offset]
            );
        }
    }
    if (sum > 65535u) {
        atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
    }
    uint output_frame_elements = out_rows * out_cols;
    out[ulong(frame) * ulong(output_frame_elements) + output_row * out_cols
        + output_col] = ushort(min(sum, 65535u));
}

// Bin-8 specialization of the generic fused kernel. A 24x24 detector result
// does not fill the generic 8x16 output grid: its final column stages and
// computes eight padded output columns. This 8x8 output tile stages exactly a
// 64x64 input region (8 KiB), so a 192x192 detector is covered by a 3x3 grid
// without padded detector work. Accumulation and overflow semantics remain
// identical to the generic exact path.
kernel void shuf_bin8_sum_8192_16_batched(
    const device uint*  in             [[buffer(0)]],
    device ushort*      out            [[buffer(1)]],
    const device uchar* mask           [[buffer(2)]],
    constant uint&      in_rows        [[buffer(3)]],
    constant uint&      in_cols        [[buffer(4)]],
    constant uint&      frame_u16s     [[buffer(5)]],
    constant uint&      out_rows       [[buffer(6)]],
    constant uint&      out_cols       [[buffer(7)]],
    constant uint&      bin_factor     [[buffer(8)]],
    device atomic_uint* overflow       [[buffer(9)]],
    uint3 group_position               [[threadgroup_position_in_grid]],
    uint thread_index                  [[thread_index_in_threadgroup]],
    uint lane                          [[thread_index_in_simdgroup]],
    uint simdgroup_index               [[simdgroup_index_in_threadgroup]]
) {
    (void)bin_factor;
    constexpr uint output_tile_rows = 8u;
    constexpr uint output_tile_cols = 8u;
    constexpr uint input_tile_rows = output_tile_rows * 8u;
    constexpr uint input_tile_cols = output_tile_cols * 8u;
    constexpr uint row_word_groups = input_tile_cols / 32u;
    constexpr uint tile_word_groups = input_tile_rows * row_word_groups;
    constexpr uint groups_per_block = 128u;
    constexpr uint simdgroups_per_threadgroup = 8u;

    uint frame = group_position.x;
    uint input_origin_row = group_position.y * input_tile_rows;
    uint input_origin_col = group_position.z * input_tile_cols;
    threadgroup ushort tile[input_tile_rows * input_tile_cols];
    threadgroup uint planes[simdgroups_per_threadgroup][16u];

    for (
        uint tile_group = simdgroup_index;
        tile_group < tile_word_groups;
        tile_group += simdgroups_per_threadgroup
    ) {
        uint local_row = tile_group / row_word_groups;
        uint local_word_group = tile_group - local_row * row_word_groups;
        uint source_row = input_origin_row + local_row;
        uint source_col = input_origin_col + local_word_group * 32u;
        bool valid_group = source_row < in_rows && source_col < in_cols;

        if (lane < 16u) {
            uint plane_word = 0u;
            if (valid_group) {
                uint source_pixel = source_row * in_cols + source_col;
                uint block = source_pixel >> 12u;
                uint group_in_block = (source_pixel & 4095u) >> 5u;
                const device uint* block_in = in
                    + ulong(frame) * ulong(frame_u16s / 2u)
                    + block * 2048u;
                plane_word = block_in[lane * groups_per_block + group_in_block];
            }
            planes[simdgroup_index][lane] = plane_word;
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);

        ushort value = 0u;
        for (uint bit = 0u; bit < 16u; ++bit) {
            if (planes[simdgroup_index][bit] & (1u << lane)) {
                value |= ushort(1u << bit);
            }
        }
        uint detector_col = source_col + lane;
        bool valid_pixel = valid_group && detector_col < in_cols;
        uint detector_pixel = source_row * in_cols + detector_col;
        if (!valid_pixel || mask[detector_pixel] != 0u) {
            value = 0u;
        }
        tile[local_row * input_tile_cols + local_word_group * 32u + lane] = value;
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (thread_index >= output_tile_rows * output_tile_cols) return;
    uint local_output_row = thread_index / output_tile_cols;
    uint local_output_col = thread_index - local_output_row * output_tile_cols;
    uint output_row = group_position.y * output_tile_rows + local_output_row;
    uint output_col = group_position.z * output_tile_cols + local_output_col;
    if (output_row >= out_rows || output_col >= out_cols) return;

    uint tile_row = local_output_row * 8u;
    uint tile_col = local_output_col * 8u;
    uint sum = 0u;
    for (uint row_offset = 0u; row_offset < 8u; ++row_offset) {
        for (uint col_offset = 0u; col_offset < 8u; ++col_offset) {
            sum += uint(
                tile[(tile_row + row_offset) * input_tile_cols
                     + tile_col + col_offset]
            );
        }
    }
    if (sum > 65535u) {
        atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
    }
    uint output_frame_elements = out_rows * out_cols;
    out[ulong(frame) * ulong(output_frame_elements) + output_row * out_cols
        + output_col] = ushort(min(sum, 65535u));
}

// Optional decode-side detector sum. Each source chunk gets an independent
// output plane, so concurrently executing decode command buffers never race.
kernel void detector_sum_u8_decode_partial(
    device const uchar* data     [[buffer(0)]],
    device uint*        partial  [[buffer(1)]],
    constant uint&      ndet     [[buffer(2)]],
    constant uint&      nframes  [[buffer(3)]],
    uint gid [[thread_position_in_grid]]
) {
    constexpr uint frames_per_block = 1024u;
    uint block = gid / ndet;
    uint pix = gid - block * ndet;
    uint frame_start = block * frames_per_block;
    if (pix >= ndet || frame_start >= nframes) return;
    uint frame_stop = min(frame_start + frames_per_block, nframes);
    uint sum = 0u;
    for (uint fr = frame_start; fr < frame_stop; ++fr) {
        sum += uint(data[(ulong)fr * ndet + pix]);
    }
    partial[(ulong)block * ndet + pix] = sum;
}

kernel void detector_sum_u8_decode_merge(
    device const uint* partial [[buffer(0)]],
    device uint*       out     [[buffer(1)]],
    constant uint&     ndet    [[buffer(2)]],
    constant uint&     nblocks [[buffer(3)]],
    uint pix [[thread_position_in_grid]]
) {
    if (pix >= ndet) return;
    uint sum = 0u;
    for (uint block = 0; block < nblocks; ++block) {
        sum += partial[(ulong)block * ndet + pix];
    }
    out[pix] = sum;
}

kernel void detector_sum_u8_decode_final(
    device const uint* chunk_sums [[buffer(0)]],
    device uint*       out        [[buffer(1)]],
    constant uint&     ndet       [[buffer(2)]],
    constant uint&     nchunks    [[buffer(3)]],
    uint pix [[thread_position_in_grid]]
) {
    if (pix >= ndet) return;
    uint sum = 0u;
    for (uint chunk = 0; chunk < nchunks; ++chunk) {
        sum += chunk_sums[(ulong)chunk * ndet + pix];
    }
    out[pix] = sum;
}

// =====================================================================
// Kernel 3: Detector binning — integer SUM, mask-aware, native uint16 out.
// quantem.live diverges from the widget here: it sums (not means) and keeps
// the native uint16 dtype, and zeroes dead pixels BEFORE summing (mask, nonzero
// = dead), so a binned MPS load is bit-identical to a cuda integer-sum bin.
// The mask buffer is one detector frame (det_row*det_col uchar), shared by all
// frames. Reads from bitshuffle output.
// Grid:  (n_frames, ceil(out_rows/16), ceil(out_cols/16))
// Block: (1, 16, 16)
// =====================================================================
kernel void bin_sum_u16(
    const device ushort* in  [[buffer(0)]],
    device ushort*       out [[buffer(1)]],
    constant uint& in_row_stride  [[buffer(2)]],
    constant uint& in_frame_elems [[buffer(3)]],
    constant uint& out_cols       [[buffer(4)]],
    constant uint& out_frame_elems [[buffer(5)]],
    constant uint& bin_factor     [[buffer(6)]],
    const device uchar* mask [[buffer(7)]],
    constant uint& out_rows [[buffer(8)]],
    device atomic_uint* overflow [[buffer(9)]],
    uint3 pos [[thread_position_in_grid]]
) {
    uint frame = pos.x;
    uint out_r = pos.y;
    uint out_c = pos.z;
    if (out_c >= out_cols || out_r >= out_rows) return;
    uint in_r = out_r * bin_factor;
    uint in_c = out_c * bin_factor;
    ulong in_base = ulong(frame) * ulong(in_frame_elems);
    ulong sum = 0ul;
    for (uint br = 0; br < bin_factor; br++)
        for (uint bc = 0; bc < bin_factor; bc++) {
            uint pix = (in_r + br) * in_row_stride + in_c + bc;
            if (mask[pix] == 0)  // skip dead pixels (treat as 0)
                sum += uint(in[in_base + pix]);
        }
    if (sum > 65535u) {
        atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
    }
    out[ulong(frame) * ulong(out_frame_elems) + out_r * out_cols + out_c] =
        ushort(min(sum, ulong(65535u)));
}

kernel void bin_sum_u32(
    const device uint* in    [[buffer(0)]],
    device uint*       out   [[buffer(1)]],
    constant uint& in_row_stride  [[buffer(2)]],
    constant uint& in_frame_elems [[buffer(3)]],
    constant uint& out_cols       [[buffer(4)]],
    constant uint& out_frame_elems [[buffer(5)]],
    constant uint& bin_factor     [[buffer(6)]],
    const device uchar* mask [[buffer(7)]],
    constant uint& out_rows [[buffer(8)]],
    device atomic_uint* overflow [[buffer(9)]],
    uint3 pos [[thread_position_in_grid]]
) {
    uint frame = pos.x;
    uint out_r = pos.y;
    uint out_c = pos.z;
    if (out_c >= out_cols || out_r >= out_rows) return;
    uint in_r = out_r * bin_factor;
    uint in_c = out_c * bin_factor;
    ulong in_base = ulong(frame) * ulong(in_frame_elems);
    ulong sum = 0ul;
    for (uint br = 0; br < bin_factor; br++)
        for (uint bc = 0; bc < bin_factor; bc++) {
            uint pix = (in_r + br) * in_row_stride + in_c + bc;
            if (mask[pix] == 0)
                sum += ulong(in[in_base + pix]);
        }
    constexpr ulong uint_max = 0xfffffffful;
    if (sum > uint_max) {
        atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
    }
    out[ulong(frame) * ulong(out_frame_elems) + out_r * out_cols + out_c] =
        uint(min(sum, ulong(uint_max)));
}

// =====================================================================
// Tiled bin (uint16): each 16x16-thread group bins one 16x16 output tile.
// The threads first COOPERATIVELY + COALESCED load the (16*bin)x(16*bin)
// input region into threadgroup memory (consecutive threads read consecutive
// detector columns), then each thread sums its bin_factor^2 block from fast
// threadgroup memory. The old per-thread strided global gather ran at ~2% of
// M5 bandwidth; this is memory-coalesced. Supports bin_factor up to 4
// (tile <= 64x64 ushort = 8 KB threadgroup). Dead pixels (mask) zeroed at load.
// Grid:  (n_frames, ceil(out_rows/16), ceil(out_cols/16)), Block: (1,16,16)
// =====================================================================
kernel void bin_sum_tiled_u16(
    const device ushort* in  [[buffer(0)]],
    device ushort*       out [[buffer(1)]],
    constant uint& in_row_stride  [[buffer(2)]],
    constant uint& in_frame_elems [[buffer(3)]],
    constant uint& out_cols       [[buffer(4)]],
    constant uint& out_frame_elems [[buffer(5)]],
    constant uint& bin_factor     [[buffer(6)]],
    const device uchar* mask [[buffer(7)]],
    constant uint& out_rows       [[buffer(8)]],
    device atomic_uint* overflow  [[buffer(9)]],
    uint3 tg  [[threadgroup_position_in_grid]],
    uint3 lid [[thread_position_in_threadgroup]]
) {
    threadgroup ushort tile[64 * 64];  // bin_factor <= 4
    uint B = bin_factor;
    uint ts = 16u * B;                 // input tile side
    uint tile_or = tg.y * 16u;         // output tile origin
    uint tile_oc = tg.z * 16u;
    uint in_or = tile_or * B;          // input tile origin
    uint in_oc = tile_oc * B;
    ulong in_base = ulong(tg.x) * ulong(in_frame_elems);
    uint lin = lid.y * 16u + lid.z;    // 0..255
    // Coalesced cooperative load of the ts*ts input region (+ mask zero).
    for (uint i = lin; i < ts * ts; i += 256u) {
        uint rr = i / ts, cc = i % ts;
        uint gr = in_or + rr, gc = in_oc + cc;
        uint pix = gr * in_row_stride + gc;
        tile[i] = (mask[pix] == 0) ? in[in_base + pix] : ushort(0);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint out_r = tile_or + lid.y;
    uint out_c = tile_oc + lid.z;
    if (out_r >= out_rows || out_c >= out_cols) return;
    uint sum = 0u;
    uint base_r = lid.y * B, base_c = lid.z * B;
    for (uint br = 0; br < B; br++)
        for (uint bc = 0; bc < B; bc++)
            sum += uint(tile[(base_r + br) * ts + base_c + bc]);
    if (sum > 65535u) {
        atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
    }
    out[ulong(tg.x) * ulong(out_frame_elems) + out_r * out_cols + out_c] =
        ushort(min(sum, 65535u));
}

// Zero detector pixels marked bad after raw no-bin decode. The common Arina
// masks contain only a few pixels; doing this on CPU with arr[:, bad] creates
// a slow strided write over all frames. This tiny Metal pass keeps raw-load
// masking inside the command buffer that produced the chunk.
kernel void zero_bad_pixels_u16(
    device ushort*      data    [[buffer(0)]],  // (nframes, ndet) uint16
    device const uint*  bad_pix [[buffer(1)]],  // flat detector indices
    constant uint&      ndet    [[buffer(2)]],
    constant uint&      nbad    [[buffer(3)]],
    constant uint&      nframes [[buffer(4)]],
    uint gid [[thread_position_in_grid]]
) {
    uint total = nframes * nbad;
    if (gid >= total) return;
    uint frame = gid / nbad;
    uint bad_i = gid - frame * nbad;
    uint pix = bad_pix[bad_i];
    if (pix < ndet) {
        data[ulong(frame) * ulong(ndet) + ulong(pix)] = 0;
    }
}

kernel void zero_bad_pixels_u32(
    device uint*        data    [[buffer(0)]],  // (nframes, ndet) uint32
    device const uint*  bad_pix [[buffer(1)]],  // flat detector indices
    constant uint&      ndet    [[buffer(2)]],
    constant uint&      nbad    [[buffer(3)]],
    constant uint&      nframes [[buffer(4)]],
    uint gid [[thread_position_in_grid]]
) {
    uint total = nframes * nbad;
    if (gid >= total) return;
    uint frame = gid / nbad;
    uint bad_i = gid - frame * nbad;
    uint pix = bad_pix[bad_i];
    if (pix < ndet) {
        data[ulong(frame) * ulong(ndet) + ulong(pix)] = uint(0);
    }
}

kernel void clip_u16_to_u8(
    device const ushort* in  [[buffer(0)]],
    device uchar*        out [[buffer(1)]],
    constant uint&       n   [[buffer(2)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= n) return;
    out[gid] = (uchar)min((uint)in[gid], 255u);
}

kernel void clip_u32_to_u8(
    device const uint* in   [[buffer(0)]],
    device uchar*      out  [[buffer(1)]],
    constant uint&     n    [[buffer(2)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= n) return;
    uint value = in[gid];
    out[gid] = uchar(value > 255u ? 255u : value);
}

kernel void narrow_u32_to_u16_masked(
    device const uint*  in       [[buffer(0)]],
    device ushort*      out      [[buffer(1)]],
    device const uchar* mask     [[buffer(2)]],
    device atomic_uint* overflow [[buffer(3)]],
    constant uint&      n        [[buffer(4)]],
    constant uint&      ndet     [[buffer(5)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= n) return;
    uint pix = gid % ndet;
    uint value = (mask[pix] == 0) ? in[gid] : 0u;
    if (value > 65535u) {
        atomic_store_explicit(overflow, 1u, memory_order_relaxed);
        value = 65535u;
    }
    out[gid] = ushort(value);
}

kernel void row_prefix_masked_u16(
    device ushort*      data     [[buffer(0)]],  // (nframes, rows, cols)
    device const uchar* mask     [[buffer(1)]],  // detector mask, nonzero = dead
    device atomic_uint* overflow [[buffer(2)]],
    constant uint&      detcols  [[buffer(3)]],
    constant uint&      detrows  [[buffer(4)]],
    constant uint&      nframes  [[buffer(5)]],
    uint gid [[thread_position_in_grid]]
) {
    uint total_rows = nframes * detrows;
    if (gid >= total_rows) return;
    uint frame = gid / detrows;
    uint row = gid - frame * detrows;
    ulong base = (ulong)frame * detrows * detcols + (ulong)row * detcols;
    uint acc = 0;
    for (uint col = 0; col < detcols; col++) {
        uint pix = row * detcols + col;
        ushort raw = (mask[pix] == 0) ? data[base + col] : ushort(0);
        acc += uint(raw);
        if (acc > 65535u) {
            atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
        }
        data[base + col] = ushort(acc);
    }
}

kernel void row_prefix_u16(
    device ushort*      data     [[buffer(0)]],  // (nframes, rows, cols)
    device atomic_uint* overflow [[buffer(1)]],
    constant uint&      detcols  [[buffer(2)]],
    constant uint&      detrows  [[buffer(3)]],
    constant uint&      nframes  [[buffer(4)]],
    uint gid [[thread_position_in_grid]]
) {
    uint total_rows = nframes * detrows;
    if (gid >= total_rows) return;
    uint frame = gid / detrows;
    uint row = gid - frame * detrows;
    ulong base = (ulong)frame * detrows * detcols + (ulong)row * detcols;
    uint acc = 0;
    for (uint col = 0; col < detcols; col++) {
        acc += uint(data[base + col]);
        if (acc > 65535u) {
            atomic_fetch_or_explicit(&overflow[0], 1u, memory_order_relaxed);
        }
        data[base + col] = ushort(acc);
    }
}
