    device const uint*   data    [[buffer(0)]],  // raw (nframes, ndet)
    device const uint*   starts  [[buffer(1)]],  // inclusive flat span starts
    device const uint*   ends    [[buffer(2)]],  // inclusive flat span ends
    device ulong*        out     [[buffer(3)]],  // (nframes,) uint64
    constant uint&       nspans  [[buffer(4)]],
    constant uint&       ndet    [[buffer(5)]],
    constant uint&       nframes [[buffer(6)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= nframes) return;
    device const uint* frame = data + (ulong)gid * ndet;
    ulong s = 0ul;
    for (uint sp = 0; sp < nspans; sp++) {
        uint start = starts[sp];
        uint end = ends[sp];
        for (uint pix = start; pix <= end; pix++) {
            s += (ulong)frame[pix];
        }
    }
    out[gid] = s;
}

// Centre-of-mass moments per scan position over the masked detector: the total
// Sum I, Sum row*I and Sum col*I, exact in 64-bit integers, as three ulongs per
// frame. Metal has no double, so the host divides in float64 and rounds once to
// float32, exactly as the CUDA kernel does; a float32 quotient on the GPU differed.
// col/row come from the linear detector index (col = i % detcols, row = i / detcols).
kernel void com_u16(
    device const ushort* data    [[buffer(0)]],   // (nframes, ndet) uint16, flat
    device const uchar*  mask    [[buffer(1)]],   // (ndet,) 0/1
    device ulong*        out     [[buffer(2)]],   // (nframes, 3) total, row moment, col moment
    constant uint&       ndet    [[buffer(3)]],
    constant uint&       detcols [[buffer(4)]],   // detector width
    constant uint&       nframes [[buffer(5)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= nframes) return;
    device const ushort* frame = data + (ulong)gid * ndet;
    ulong total = 0ul, row_sum = 0ul, col_sum = 0ul;
    for (uint i = 0; i < ndet; i++) {
        if (mask[i]) {
            ulong v = (ulong)frame[i];
            total += v;
            row_sum += v * (ulong)(i / detcols);
            col_sum += v * (ulong)(i % detcols);
        }
    }
    out[3 * (ulong)gid] = total;
    out[3 * (ulong)gid + 1] = row_sum;
    out[3 * (ulong)gid + 2] = col_sum;
}

kernel void com_u8(
    device const uchar*  data    [[buffer(0)]],   // (nframes, ndet) uint8, flat
    device const uchar*  mask    [[buffer(1)]],   // (ndet,) 0/1
    device ulong*        out     [[buffer(2)]],   // (nframes, 3) total, row moment, col moment
    constant uint&       ndet    [[buffer(3)]],
    constant uint&       detcols [[buffer(4)]],
    constant uint&       nframes [[buffer(5)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= nframes) return;
    device const uchar* frame = data + (ulong)gid * ndet;
    ulong total = 0ul, row_sum = 0ul, col_sum = 0ul;
    for (uint i = 0; i < ndet; i++) {
        if (mask[i]) {
            ulong v = (ulong)frame[i];
            total += v;
            row_sum += v * (ulong)(i / detcols);
            col_sum += v * (ulong)(i % detcols);
        }
    }
    out[3 * (ulong)gid] = total;
    out[3 * (ulong)gid + 1] = row_sum;
    out[3 * (ulong)gid + 2] = col_sum;
}

kernel void com_u32(
    device const uint*   data    [[buffer(0)]],   // (nframes, ndet) uint32, flat
    device const uchar*  mask    [[buffer(1)]],   // (ndet,) 0/1
    device ulong*        out     [[buffer(2)]],   // (nframes, 3) total, row moment, col moment
    constant uint&       ndet    [[buffer(3)]],
    constant uint&       detcols [[buffer(4)]],
    constant uint&       nframes [[buffer(5)]],
    uint gid [[thread_position_in_grid]]
) {
    if (gid >= nframes) return;
    device const uint* frame = data + (ulong)gid * ndet;
    ulong total = 0ul, row_sum = 0ul, col_sum = 0ul;
    for (uint i = 0; i < ndet; i++) {
        if (mask[i]) {
            ulong v = (ulong)frame[i];
            total += v;
            row_sum += v * (ulong)(i / detcols);
            col_sum += v * (ulong)(i % detcols);
        }
    }
    out[3 * (ulong)gid] = total;
    out[3 * (ulong)gid + 1] = row_sum;
    out[3 * (ulong)gid + 2] = col_sum;
}
