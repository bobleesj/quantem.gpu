// uint8 frames sum four pixels per thread over 1024-frame blocks (at most
// 1024 * 255 per block, exact in int32), then each pixel adds its blocks in 64 bits.
kernel void detector_sum_u8_block_partial(
    device const uchar* data     [[buffer(0)]],
    device int*         partial  [[buffer(1)]],
    constant uint&      ndet     [[buffer(2)]],
    constant uint&      nframes  [[buffer(3)]],
    uint gid [[thread_position_in_grid]]
) {
    constexpr uint frames_per_block = 1024u;
    uint pixel_groups = ndet / 4u;
    uint block = gid / pixel_groups;
    uint pixel_group = gid - block * pixel_groups;
    uint pix = pixel_group * 4u;
    uint frame_start = block * frames_per_block;
    if (pix + 3u >= ndet || frame_start >= nframes) return;
    uint frame_stop = min(frame_start + frames_per_block, nframes);
    int4 sums = int4(0);
    for (uint fr = frame_start; fr < frame_stop; ++fr) {
        uchar4 values = *reinterpret_cast<device const uchar4*>(
            data + (ulong)fr * ndet + pix
        );
        sums += int4(values);
    }
    device int4* out = reinterpret_cast<device int4*>(
        partial + (ulong)block * ndet + pix
    );
    *out = sums;
}

kernel void detector_sum_u8_block_merge(
    device const int* partial    [[buffer(0)]],
    device ulong* out            [[buffer(1)]],  // (ndet,) uint64, one chunk
    constant uint& ndet          [[buffer(2)]],
    constant uint& nblocks       [[buffer(3)]],
    uint pix [[thread_position_in_grid]]
) {
    if (pix >= ndet) return;
    ulong sum = 0ul;
    for (uint block = 0; block < nblocks; ++block) {
        sum += (ulong)partial[(ulong)block * ndet + pix];
    }
    out[pix] = sum;
}

#define GATHER_COLUMNS_F32_TILED(NAME, TYPE) \
kernel void NAME( \
    device const TYPE* data       [[buffer(0)]], \
    device const uint* indices    [[buffer(1)]], \
    device float* out             [[buffer(2)]], \
    constant uint& ndet           [[buffer(3)]], \
    constant uint& nframes        [[buffer(4)]], \
    constant uint& total_frames   [[buffer(5)]], \
    constant uint& frame_offset   [[buffer(6)]], \
    constant uint& npixels        [[buffer(7)]], \
    uint2 group [[threadgroup_position_in_grid]], \
    uint2 local [[thread_position_in_threadgroup]] \
) { \
    threadgroup float tile[16][17]; \
    uint load_pixel = group.x * 16u + local.x; \
    uint load_frame = group.y * 16u + local.y; \
    float value = 0.0f; \
    if (load_pixel < npixels && load_frame < nframes) { \
        value = (float)data[(ulong)load_frame * ndet + indices[load_pixel]]; \
    } \
    tile[local.y][local.x] = value; \
    threadgroup_barrier(mem_flags::mem_threadgroup); \
    uint store_pixel = group.x * 16u + local.y; \
    uint store_frame = group.y * 16u + local.x; \
    if (store_pixel < npixels && store_frame < nframes) { \
        out[(ulong)store_pixel * total_frames + frame_offset + store_frame] = \
            tile[local.x][local.y]; \
    } \
}

GATHER_COLUMNS_F32_TILED(gather_columns_f32_tiled_u8, uchar)
GATHER_COLUMNS_F32_TILED(gather_columns_f32_tiled_u16, ushort)
GATHER_COLUMNS_F32_TILED(gather_columns_f32_tiled_u32, uint)

#undef GATHER_COLUMNS_F32_TILED
kernel void bin_detector_u16(
    device const ushort* data    [[buffer(0)]],  // raw (nframes, detrows, detcols)
    device ushort*       out     [[buffer(1)]],  // binned (nframes, detrows/f, detcols/f)
    constant uint&       detcols [[buffer(2)]],
    constant uint&       outcols [[buffer(3)]],
    constant uint&       outndet [[buffer(4)]],
    constant uint&       nframes [[buffer(5)]],
    constant uint&       binf    [[buffer(6)]],  // bin factor f (2, 4, ...)
    uint gid [[thread_position_in_grid]]
) {
    // General f x f detector bin. One thread per output pixel sums the f*f raw
    // pixels under it (clamped to uint16),
    // so any even-divisor sidecar (bin2, bin4) reuses one kernel. bin4 keeps the
    // scrub sidecar small enough to fit a 24 GB Mac (1.2 GB vs bin2's 4.8 GB).
    uint total = nframes * outndet;
    if (gid >= total) return;
    uint fr = gid / outndet;
    uint opix = gid - fr * outndet;
    uint orow = opix / outcols;
    uint ocol = opix - orow * outcols;
    ulong base = (ulong)fr * (outndet * binf * binf)
               + (ulong)(orow * binf) * detcols + (ocol * binf);
    uint s = 0;
    for (uint dr = 0; dr < binf; dr++) {
        ulong rowbase = base + (ulong)dr * detcols;
        for (uint dc = 0; dc < binf; dc++) {
            s += (uint)data[rowbase + dc];
        }
    }
    out[gid] = (ushort)min(s, 65535u);
}

kernel void bin_detector_u8(
    device const uchar*  data    [[buffer(0)]],  // raw (nframes, detrows, detcols)
    device ushort*       out     [[buffer(1)]],  // binned uint16 sums
    constant uint&       detcols [[buffer(2)]],
    constant uint&       outcols [[buffer(3)]],
    constant uint&       outndet [[buffer(4)]],
    constant uint&       nframes [[buffer(5)]],
    constant uint&       binf    [[buffer(6)]],
    uint gid [[thread_position_in_grid]]
) {
    uint total = nframes * outndet;
    if (gid >= total) return;
    uint fr = gid / outndet;
    uint opix = gid - fr * outndet;
    uint orow = opix / outcols;
    uint ocol = opix - orow * outcols;
    ulong base = (ulong)fr * (outndet * binf * binf)
               + (ulong)(orow * binf) * detcols + (ocol * binf);
    uint s = 0;
    for (uint dr = 0; dr < binf; dr++) {
        ulong rowbase = base + (ulong)dr * detcols;
        for (uint dc = 0; dc < binf; dc++) {
            s += (uint)data[rowbase + dc];
        }
    }
    out[gid] = (ushort)min(s, 65535u);
}

kernel void mean_dp_sum_u16(
    device const ushort* data          [[buffer(0)]],  // raw (nframes, ndet)
    device const uint*   frame_indices [[buffer(1)]],  // local frame indices
    device ulong*        out           [[buffer(2)]],  // (ndet,) uint64 sum
    constant uint&       ndet          [[buffer(3)]],
    constant uint&       nindices      [[buffer(4)]],
    uint pix [[thread_position_in_grid]]
) {
    if (pix >= ndet) return;
    ulong s = 0ul;
    for (uint i = 0; i < nindices; i++) {
        s += (ulong)data[(ulong)frame_indices[i] * ndet + pix];
    }
    out[pix] = s;
}

