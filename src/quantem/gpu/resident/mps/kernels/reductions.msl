}

kernel void detector_sum_exact_u32(
    device const uint* data      [[buffer(0)]],  // (nframes, ndet) uint32
    device ulong*      out       [[buffer(1)]],  // (ndet,) uint64, one chunk
    constant uint&     ndet      [[buffer(2)]],
    constant uint&     nframes   [[buffer(3)]],
    uint pix [[thread_position_in_grid]]
