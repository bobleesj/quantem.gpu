    {
      "id": "io.packed-display-precision",
      "contract_version": "precision/v1",
      "public_owner": "quantem.gpu.io.load / quantem.gpu.io.save",
      "parity": "Explicit scaled uint16 codes (source-wide or per region; saved float16 exports convert on load) held ANS encoded on the device, restored intensity units, selected scan and detector regions, and GPU-measured error reports persisted through HDF5 export.",
      "coverage": {
        "cpu-reference": {
          "level": "not-implemented",
          "gates": [
            "docs/maintainer/migration.md"
          ],
          "qualification": "Accelerator implementations are required; CPU scientific conversion is intentionally unsupported."
        },
        "cuda": {
          "level": "required-hardware",
          "gates": [
            "tests/hardware/cuda/test_precision.py",
            "tests/parity/precision_fixture.py"
          ],
          "qualification": "CUDA save/load, exact restored frames, scan and detector regions, mean diffraction, binary detector sums, and persisted error reports against the shared independent NumPy oracle."
        },
        "mps": {
          "level": "required-hardware",
          "gates": [
            "tests/hardware/mps/test_precision.py",
            "tests/parity/precision_fixture.py"
          ],
          "qualification": "Python Metal/MPS save/load, exact restored frames, scan and detector regions, mean diffraction, binary detector sums, and persisted error reports against the shared independent NumPy oracle; numerical reports use float32 Metal reductions."
        },
        "swift-metal": {
          "level": "partial-hardware",
          "gates": [
            "docs/api/native_resident.md",
            "tests/hardware/mps/test_precision.py"
          ],
          "qualification": "Native scaled uint16 conversion, exact packed reads, GPU error accounting and standard HDF5 save/reopen are implemented and checked in the native MAPED consumer on an Apple Silicon workstation. Float16 native export, arbitrary detector geometry, detector-query coverage and minimum-memory release signoff remain incomplete."
        },
        "webgpu": {
          "level": "not-implemented",
          "gates": [
            "docs/maintainer/migration.md"
          ],
          "qualification": "CUDA save/load, selections and detector queries; Metal and browser-only precision formats are not implemented."
        }
      }
    },
    {
      "id": "io.empad-float-resident",
      "contract_version": "empad-source/v1",
      "public_owner": "quantem.gpu.io.load / NativeEMPADSource.open / MetalEMPADResidentSource.load",
      "parity": "Original 128x128 float32 detector bits, explicit rectangular scan shape, footer separation, selected-frame ordering, and floating-point aperture sums without quantization.",
      "coverage": {
        "cpu-reference": {"level": "reference-fixture", "gates": ["tests/hardware/metal/test_empad_source.py", "tests/hardware/metal/test_empad_public.py"], "qualification": "Independent original-byte and NumPy float64 aperture oracles; not a Python resident implementation."},
        "swift-metal": {"level": "partial-hardware", "gates": ["tests/hardware/metal/test_empad_source.py", "tests/hardware/metal/test_empad_public.py"], "qualification": "Native original EMPAD source, exact float-word packing, DP and aperture kernels. Consumer integration, DPC, full cancellation and native release gates remain pending."},
        "cuda": {"level": "partial-hardware", "gates": ["tests/hardware/test_array_ans_workflows.py", "docs/maintainer/empad-contract.md"], "qualification": "io.load reads EMPAD XML/RAW and EMPAD2 XML records through formats.empad.load_array_source into a float32 ANS resident with unchanged IEEE bits. The QEM_TEST_BACKEND=cuda hardware tests use synthetic records: native frames and .qem round trips are bit-exact, EMPAD record footer words are excluded, several XML detector regions are kept as metadata, and encoded EMPAD2 sensor words are rejected. No real EMPAD acquisition, DPC or performance qualification is retained."},
        "mps": {"level": "partial-hardware", "gates": ["tests/hardware/test_array_ans_workflows.py", "docs/maintainer/empad-contract.md"], "qualification": "io.load reads EMPAD XML/RAW and EMPAD2 XML records through formats.empad.load_array_source into a float32 ANS resident with unchanged IEEE bits. The QEM_TEST_BACKEND=mps hardware tests use synthetic records: native frames and .qem round trips are bit-exact, EMPAD record footer words are excluded, several XML detector regions are kept as metadata, and encoded EMPAD2 sensor words are rejected. No real EMPAD acquisition, DPC or performance qualification is retained."},
        "webgpu": {"level": "not-implemented", "gates": ["docs/maintainer/empad-contract.md"]}
      }
