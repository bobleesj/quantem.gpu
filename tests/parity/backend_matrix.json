{
  "schema_version": 1,
  "backends": [
    "cpu-reference",
    "cuda",
    "mps",
    "swift-metal",
    "webgpu"
  ],
  "contract": {
    "coordinate_order": "row-column",
    "real_space_crop": "explicit-only",
    "detector_bin": "explicit-count-preserving-with-partial-edges",
    "cpu_fallback": "explicit-reference-only",
    "integer_outputs": "byte-exact",
    "floating_outputs": "frozen-operation-specific-metric",
    "required_provenance": [
      "source_identity",
      "source_shape",
      "source_dtype",
      "scan_region",
      "detector_region",
      "scan_bin",
      "detector_bin",
      "output_shape",
      "output_dtype",
      "backend",
      "device",
      "source_revision"
    ]
  },
  "gold_fixtures": {
    "scan_rotation_v1": {
      "path": "src/quantem/gpu/parity/scan_rotation_v1.json",
      "sha256": "8dde7144ae5f297dffc7b1330b6db66301ff42849a39b6adadfb078acb6fd35f"
    }
  },
  "capabilities": [
