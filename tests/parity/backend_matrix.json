          "gates": [
            "tests/hardware/cuda/test_ans_resident.py",
            "tests/hardware/test_ans_io_acceptance.py"
          ]
        },
        "mps": {
          "level": "required",
          "implemented_selectors": [
            "scan_region"
          ],
          "qualification": "encoded-resident-read(scan_region, detector_region); io.load keeps complete acquisitions and has no sparse selectors",
          "gates": [
            "tests/hardware/mps/test_resident_read.py",
            "tests/hardware/mps/test_mps_buffer_release.py"
          ]
        },
        "swift-metal": {
          "level": "not-implemented",
          "implemented_selectors": [],
          "implemented_subset": [
            "strict-half-open-rectangle-load-plan",
            "single-position-indexed-accessor"
          ],
          "limitations": [
            "no-bulk-rectangle-loader",
            "no-detector-region-selective-loader"
          ],
          "gates": [
            "native/swift/Sources/Metal4DSTEMKernels/Metal4DSTEMLoadPlan.swift",
            "native/swift/Sources/Native4DSTEMIO/Native4DSTEMIndexedSource.swift",
            "native/swift/Sources/Metal4DSTEMStreamingIO/Metal4DSTEMIndexedLoader.swift"
          ]
        },
        "webgpu": {
          "level": "partial-hardware",
          "implemented_selectors": [
