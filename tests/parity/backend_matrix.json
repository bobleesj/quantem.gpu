    {
      "id": "io.selective-scan-loading",
      "contract_version": "quantem-gpu-selective-scan/v1",
      "public_owner": "quantem.gpu.io.load",
      "parity": "Exact selected detector evidence with backend-neutral row/column selectors, request order, duplicates, dtype, shape, failure behavior, and provenance.",
      "selectors": {
        "mutually_exclusive": [
          "scan_region",
          "scan_indices",
          "random_positions"
        ],
        "scan_region": {
          "coordinates": [
            "scan_row_start",
            "scan_row_stop",
            "scan_column_start",
            "scan_column_stop"
          ],
          "interval": "half-open",
          "bounds": "nonempty-and-contained-in-source-scan",
          "output_order": "logical-row-major",
          "output_shape": "(selected_scan_rows, selected_scan_columns, detector_rows, detector_columns)"
        },
        "scan_indices": {
          "coordinate_forms": [
            "logical-flat-row-major",
            "ordered-(scan_row,scan_column)-pairs"
          ],
          "bounds": "nonempty-and-contained-in-source-scan",
          "output_order": "request-order-preserved",
          "duplicates": "preserved",
          "output_shape": "(requested_positions, detector_rows, detector_columns)"
        },
        "random_positions": {
          "index_space": "logical-row-major-scan",
          "seed": "same-integer-seed-reproduces-selection",
          "replace_default": false,
          "replace_false": "unique-positions",
          "replace_true": "duplicates-allowed",
          "output_contract": "scan_indices"
        }
      },
      "detector_region": {
        "requires_selector": "scan_region",
        "coordinates": [
          "detector_row_start",
          "detector_row_stop",
          "detector_column_start",
          "detector_column_stop"
        ],
        "interval": "half-open",
        "bounds": "nonempty-and-contained-in-working-detector",
        "application_order": "after-explicit-detector-bin",
        "output_shape": "(selected_scan_rows, selected_scan_columns, selected_detector_rows, selected_detector_columns)"
      },
      "exact_result": {
        "scan_bin": 1,
        "counts": "unchanged-exact-integer-counts",
        "detector_bin_1_dtype": "source-dtype-unless-caller-requests-a-proven-lossless-output-dtype",
        "detector_bin_gt_1_dtype": "provably-sufficient-exact-integer-dtype",
        "lossy_or_saturating_output": "outside-this-parity-contract",
        "required_provenance": [
          "source_identity",
          "source_shape",
          "source_dtype",
          "scan_selector",
          "selected_scan_positions",
          "scan_region",
          "detector_region",
